              </Card>
              {/* Monthly card */}
              <Card className="p-4 mb-4">
                <p className="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Monthly</p>
                <p className="font-black text-navy text-2xl mb-0.5">£7.99<span className="text-sm font-normal text-gray-400"> /month</span></p>
