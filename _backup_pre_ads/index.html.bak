          </div>
          <div className="bg-gray-50 rounded-xl p-4 text-center mb-4">
            <p className="text-sm text-gray-600 mb-1">Add staff members to your account so they can log records too</p>
            <p className="text-xs text-gray-400">Available in the VanGuard Fleet plan · £18.99/month</p>
          </div>
          <Btn variant="outline" onClick={()=>setSection('subscription')}>View plans</Btn>
        </Card>
      )}
      {/* ── Refer a Friend ── */}
      {(isActive||isLifetime||trialLeft>0)&&(
      <Card className="p-4 mt-4">
        <div className="flex items-center gap-3 mb-3">
          <div className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={{background:'#FFF3E0'}}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <p className="font-bold text-navy text-sm">Refer a friend — get a free month</p>
            <p className="text-xs text-gray-400">Share your link. When a friend subscribes, you both get a free month.</p>
          </div>
        </div>
        {(()=>{
          const refCode=userId.slice(0,8);
          const refUrl=`https://vanguardapp.co.uk?ref=${refCode}`;
          const [copied,setCopied]=useState(false);
          const copy=()=>{
            navigator.clipboard.writeText(refUrl).then(()=>{
              setCopied(true); setTimeout(()=>setCopied(false),2000);
            });
          };
          return (
            <div>
              <div className="flex items-center gap-2 bg-gray-50 rounded-xl px-3 py-2 mb-2">
                <p className="text-xs text-gray-600 flex-1 truncate font-mono">{refUrl}</p>
              </div>
              <Btn onClick={copy} variant={copied?'primary':'outline'} className="w-full">
                {copied?'✓ Copied!':'Copy referral link'}
              </Btn>
            </div>
          );
        })()}
      </Card>
      )}
      {/* ── Support & Feedback ── */}
      <Card className="p-4 mt-4">
        <div className="flex items-center gap-3 mb-3">
          <div className="w-10 h-10 bg-teal-light rounded-xl flex items-center justify-center flex-shrink-0">
            <Icon name="chat" size={18} color="#0D7377"/>
          </div>
          <div>
            <p className="font-bold text-navy text-sm">Support & Feedback</p>
            <p className="text-xs text-gray-400">Get help or share ideas directly with the developer</p>
          </div>
        </div>
        <div className="flex gap-2">
          <a href="https://wa.me/447922646227" target="_blank" rel="noreferrer"
            className="flex-1 flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold text-white active:opacity-80"
            style={{background:'#25D366'}}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href="mailto:hello@vanguardapp.co.uk"
            className="flex-1 flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold bg-gray-100 text-gray-700 active:bg-gray-200">
            <Icon name="mail" size={16} color="#374151"/>
            Email
          </a>
        </div>
      </Card>
    </div>
  );
};

// ── RESET PASSWORD SCREEN ────────────────────────────────────────────────────
const ResetPasswordScreen=({token,onDone})=>{
  const [pass,setPass]=useState('');
  const [confirm,setConfirm]=useState('');
  const [loading,setLoading]=useState(false);
  const [err,setErr]=useState('');
  const [ok,setOk]=useState('');
  const submit=async()=>{
    setErr('');
    if(pass.length<6){setErr('Password must be at least 6 characters.');return;}
    if(pass!==confirm){setErr('Passwords do not match.');return;}
    setLoading(true);
    const r=await fetch(`${SUPA_URL}/auth/v1/user`,{method:'PUT',headers:{'apikey':SUPA_KEY,'Content-Type':'application/json','Authorization':`Bearer ${token}`},body:JSON.stringify({password:pass})});
    const d=await r.json();
    if(d.error||d.code>=400){setErr(d.message||'Failed to update password.');setLoading(false);return;}
    setOk('Password updated! Taking you to sign in...');
    setTimeout(onDone,2000);
    setLoading(false);
  };
  return (
    <div className="min-h-screen bg-navy flex flex-col items-center justify-center p-5">
      <img src="/icon-192.png" className="mb-4 shadow-2xl" alt="VanGuard" style={{width:'80px',height:'80px',borderRadius:'20px'}}/>
      <h1 className="text-3xl font-black text-white mb-1">Van<span className="text-teal">Guard</span></h1>
      <p className="text-white/40 text-sm mb-8">Stay compliant. Keep moving.</p>
      <div className="w-full max-w-sm bg-white rounded-2xl p-6 shadow-2xl">
        <h2 className="font-black text-navy text-lg mb-1">Choose a new password</h2>
        <p className="text-sm text-gray-400 mb-4">Make it at least 6 characters.</p>
        <ErrMsg msg={err}/>
        {ok?<OkMsg msg={ok}/>:<>
          <Input label="New password" value={pass} onChange={setPass} type="password" placeholder="Min. 6 characters"/>
          <Input label="Confirm password" value={confirm} onChange={setConfirm} type="password" placeholder="Repeat password"/>
          <Btn onClick={submit} loading={loading}>Set new password</Btn>
        </>}
      </div>
    </div>
  );
};

// ── HELP DRAWER ───────────────────────────────────────────────────────────────
const HELP={
  dashboard:{title:'Dashboard',emoji:'🏠',steps:['Your daily checklist shows what needs completing before you trade.','Aim for 100% every day — tap any incomplete item to go straight there.','Come back at end of day to complete your closing and cleaning checks.','The percentage is based on diary, temps, cleaning and equipment checks.'],tip:'An EHO inspector wants to see consistent daily records. The dashboard shows at a glance whether you\'re on track.'},
  diary:{title:'Daily Diary',emoji:'📋',steps:['Complete Opening checks before you start serving.','Closing checks now include gas/power off and unit secured — not cleaning (that\'s in the Cleaning tab).','Sign off the Cleaning schedule separately after your clean.','Log your trading location — EHOs cross-reference pitch records.','Tap NA on any item that doesn\'t apply to your setup. It won\'t block completion and is remembered between sessions.'],tip:'Food Standards Agency requires written records of your daily checks. Your diary is your evidence. Consistent, complete entries are more convincing than sporadic ones.'},
  temp:{title:'Temperature Control',emoji:'🌡️',steps:['Enter the temperature in the box next to each appliance and tap Log — takes about 5 seconds.','Log at least twice a day: once at start of service, once during service.','If a reading fails, a note box appears — always record what action you took.','Use Add Appliance to add fridges, freezers or hot-hold units. Tap Remove on any you don\'t use.','Made a mistake? Tap × on a today\'s reading to delete it. Yesterday\'s readings are locked to protect your audit trail.'],tip:'Temperature control is the #1 thing EHOs check. Cold food must be ≤8°C, hot food ≥63°C. Two readings per day is the legal minimum — more is better.'},
  van:{title:'Equipment & Safety',emoji:'🔧',steps:['Complete the Equipment check every day before opening.','Tap NA on any item that doesn\'t apply — for example, gas connections if you\'re electric-only. This persists between sessions.','Log LPG inspections monthly — legally required if you use gas.','Record water tank refills under Water.','Log every trading location under Pitch.'],tip:'Mobile caterers must demonstrate their unit is maintained and safe. These records are checked at every inspection — they show you take safety seriously.'},
  records:{title:'Records',emoji:'🛡️',steps:['Use the period buttons (Today / This week / Month / All time) to filter by date range.','Use the log type tabs to browse Temps, Diary, Cleaning, Equipment, LPG, Water or Pitches.','Tap Export to PDF to open a print-ready EHO pack in a new tab.','Tap Print / Save as PDF in the export page, then hand it to the inspector.'],tip:'Handing an inspector a complete, organised pack at the start of a visit creates an excellent first impression and often reduces the time they spend on site.'},
  account:{title:'Account',emoji:'👤',steps:['Keep your business name and local authority up to date — both appear on your EHO pack.','Update your unit type (van, trailer, stall etc.) and turn LPG checks on or off here.','Use Security to change your password.'],tip:'Your local authority name appears on every EHO pack you export. Make sure it matches the council that actually inspects you.'},
};

const HelpDrawer=({screen,open,onClose})=>{
  const c=HELP[screen]||HELP.dashboard;
  return (
    <>
      {/* Overlay */}
      {open&&<div className="fixed inset-0 bg-black/40 z-40" onClick={onClose}/>}
      {/* Drawer */}
      <div style={{transform:open?'translateX(0)':'translateX(100%)',transition:'transform 0.3s cubic-bezier(0.4,0,0.2,1)'}}
        className="fixed top-0 right-0 h-full w-80 max-w-full bg-white z-50 shadow-2xl flex flex-col">
        {/* Drawer header */}
        <div className="bg-navy px-5 pt-14 pb-5 flex-shrink-0">
          <div className="flex items-center justify-between mb-1">
            <div className="flex items-center gap-2">
              <span className="text-2xl">{c.emoji}</span>
              <h3 className="font-black text-white text-lg">{c.title}</h3>
            </div>
            <button onClick={onClose} className="w-8 h-8 rounded-full bg-white/10 text-white font-bold text-lg flex items-center justify-center">✕</button>
          </div>
          <p className="text-white/50 text-xs">Tips for this screen</p>
        </div>
        {/* Drawer content */}
        <div className="flex-1 overflow-y-auto p-5">
          <p className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">How to use</p>
          <div className="space-y-4 mb-6">
            {c.steps.map((step,i)=>(
              <div key={i} className="flex gap-3">
                <div className="w-7 h-7 bg-teal rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 shadow-sm">
                  <span className="text-white text-xs font-black">{i+1}</span>
                </div>
                <p className="text-sm text-gray-700 leading-relaxed pt-1">{step}</p>
              </div>
            ))}
          </div>
          <div className="bg-navy rounded-2xl p-4">
            <p className="text-xs font-bold text-teal uppercase tracking-wide mb-2">🛡 EHO Tip</p>
            <p className="text-sm text-white/80 leading-relaxed">{c.tip}</p>
          </div>
        </div>
        {/* Footer */}
        <div className="p-5 border-t border-gray-100 flex-shrink-0">
          <Btn onClick={onClose} variant="navy">Got it</Btn>
        </div>
      </div>
    </>
  );
};

// ── INSTALL PROMPT ────────────────────────────────────────────────────────────
const InstallPrompt = ({userId}) => {
  const [show,setShow]=useState(false);
  const [isIOS,setIsIOS]=useState(false);
  const [deferred,setDeferred]=useState(null);
  const key=`vg_install_asked_${userId}`;

  useEffect(()=>{
    if(localStorage.getItem(key)) return;
    if(window.matchMedia('(display-mode: standalone)').matches) return;
    if(window.navigator.standalone) return;

    const ios=/iphone|ipad|ipod/i.test(navigator.userAgent);
    setIsIOS(ios);

    const onPrompt=e=>{e.preventDefault();setDeferred(e);};
    window.addEventListener('beforeinstallprompt',onPrompt);

    const t=setTimeout(()=>setShow(true), 45000);
    return ()=>{window.removeEventListener('beforeinstallprompt',onPrompt);clearTimeout(t);};
  },[]);

  const dismiss=()=>{setShow(false);localStorage.setItem(key,'1');};
  const install=async()=>{
    if(deferred){deferred.prompt();await deferred.userChoice;setDeferred(null);}
    dismiss();
  };

  if(!show) return null;
  return (
    <div style={{position:'fixed',bottom:0,left:0,right:0,zIndex:100,padding:'0 12px 20px',maxWidth:'512px',margin:'0 auto'}} className="fade-in">
      <div className="bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
        <div className="bg-navy px-4 py-3 flex items-center gap-3">
          <div className="w-10 h-10 bg-teal rounded-xl flex items-center justify-center flex-shrink-0">
            <VanIcon size={28} wheelColor="#0D7377"/>
          </div>
          <div className="flex-1">
            <p className="text-white font-black text-sm leading-none">Van<span className="text-teal">Guard</span></p>
            <p className="text-white/40 text-xs mt-0.5">Food safety compliance</p>
          </div>
          <button onClick={dismiss} className="text-white/30 hover:text-white/60 text-xl leading-none w-8 h-8 flex items-center justify-center">×</button>
        </div>
        <div className="p-4">
          <p className="font-bold text-navy text-sm mb-1">Add to your Home Screen</p>
          <p className="text-xs text-gray-400 leading-relaxed mb-3">Get instant access to your food safety records — works offline too.</p>
          {isIOS&&(
            <div className="bg-teal-light rounded-xl p-3 text-xs text-gray-600 leading-relaxed mb-3">
              In Safari: tap <strong className="text-teal">Share ⬆</strong> at the bottom, then <strong className="text-teal">Add to Home Screen</strong>
            </div>
          )}
          <div className="flex gap-2">
            {!isIOS&&<Btn onClick={install} variant="primary" size="sm" className="flex-1">Install App</Btn>}
            <Btn onClick={dismiss} variant="ghost" size="sm" className={isIOS?'w-full':'flex-1'}>Not now</Btn>
          </div>
        </div>
      </div>
    </div>
  );
};

const HelpFab=({onClick})=>(
  <div style={{position:'fixed',right:'16px',top:'50%',transform:'translateY(-50%)',zIndex:39,width:'44px',height:'44px'}}>
    <span className="fab-ring"/>
    <span className="fab-ring fab-ring-2"/>
    <button onClick={onClick}
      className="fab-glow relative w-11 h-11 bg-teal rounded-full flex flex-col items-center justify-center gap-0.5 active:scale-95"
      style={{border:'none',cursor:'pointer',width:'44px',height:'44px'}}>
      <span className="text-white font-black text-base leading-none">?</span>
      <span style={{color:'rgba(255,255,255,0.75)',fontSize:'8px',fontWeight:'800',letterSpacing:'0.5px',lineHeight:1}}>TIPS</span>
    </button>
  </div>
);

// ── OFFLINE BANNER ────────────────────────────────────────────────────────────
const OfflineBanner=()=>{
  const [online,setOnline]=useState(navigator.onLine);
  const [syncing,setSyncing]=useState(false);
  const [flash,setFlash]=useState('');
  useEffect(()=>{
    const goOn=async()=>{
      setOnline(true);
      if(_getQ().length>0){
        setSyncing(true);
        const n=await replayOfflineQueue();
        setSyncing(false);
        if(n>0){setFlash(`✓ ${n} record${n!==1?'s':''} synced`);setTimeout(()=>setFlash(''),3000);}
      }
    };
    const goOff=()=>setOnline(false);
    window.addEventListener('online',goOn);
    window.addEventListener('offline',goOff);
    return()=>{window.removeEventListener('online',goOn);window.removeEventListener('offline',goOff);};
  },[]);
  const bar=(bg,msg)=>(
    <div className="fixed top-0 left-0 right-0 z-[100] max-w-lg mx-auto pointer-events-none">
      <div className={`${bg} text-white text-xs font-bold py-1.5 text-center`}>{msg}</div>
    </div>
  );
  if(flash) return bar('bg-green-500',flash);
  if(syncing) return bar('bg-teal','Syncing offline records...');
  if(!online) return bar('bg-amber-500','Offline — records will sync when reconnected');
  return null;
};

// ── TRIAL BANNER (last 7 days) ────────────────────────────────────────────────
const TrialBanner=({trialLeft,onUpgrade})=>{
  if(trialLeft<=0||trialLeft>7) return null;
  const urgent=trialLeft<=3;
  return (
    <div className={`fixed left-0 right-0 z-30 max-w-lg mx-auto flex items-center justify-between px-4 py-2 ${urgent?'bg-red-500':'bg-amber-500'}`}
      style={{top:'56px'}}>
      <p className="text-white text-xs font-bold">
        {urgent?`Trial ends in ${trialLeft} day${trialLeft!==1?'s':''}!`:`${trialLeft} days left on your free trial`}
      </p>
      <button onClick={onUpgrade}
        className="bg-white text-navy text-xs font-black px-3 py-1 rounded-full active:scale-95 transition-transform ml-3 flex-shrink-0">
        Upgrade
      </button>
    </div>
  );
};

// ── PAYWALL SCREEN (trial expired) ───────────────────────────────────────────
const PaywallScreen=({userId,profile})=>{
  const [subLoading,setSubLoading]=useState('');
  const subscribe=async(plan)=>{
    setSubLoading(plan);
    try{
      const tok=_getS()?.access_token;
      const res=await fetch('/.netlify/functions/create-checkout',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},
        body:JSON.stringify({userId,email:profile?.email||_getS()?.user?.email,plan}),
      });
      const{url,error}=await res.json();
      if(error) throw new Error(error);
      window.location.href=url;
    }catch(e){alert('Could not start checkout: '+e.message);setSubLoading('');}
  };
  return (
    <div className="min-h-screen bg-navy flex flex-col items-center justify-center p-5 pt-16">
      <div className="w-full max-w-sm fade-in">
        <div className="text-center mb-7">
          <img src="/icon-192.png" className="w-16 h-16 mx-auto rounded-2xl shadow-2xl mb-4" alt="VanGuard" style={{borderRadius:'18px'}}/>
          <h1 className="text-2xl font-black text-white leading-tight">Your free trial<br/>has ended</h1>
          <p className="text-white/50 text-sm mt-2 leading-relaxed">Choose a plan to keep your records and stay EHO-ready.</p>
        </div>
        <div className="bg-white rounded-2xl p-5 mb-3 relative overflow-hidden" style={{border:'2px solid #14B8A6'}}>
          <div className="absolute top-3 right-3 bg-teal text-white text-[10px] font-black px-2 py-0.5 rounded-full tracking-wide">BEST VALUE</div>
          <p className="font-black text-navy text-sm mb-0.5">Founding Member</p>
          <div className="flex items-baseline gap-1 mb-1">
            <span className="text-3xl font-black text-navy">£99</span>
            <span className="text-gray-400 text-sm">one-off</span>
          </div>
          <p className="text-xs text-gray-500 mb-4">Pay once, use forever. Every future feature included.</p>
          <Btn variant="primary" onClick={()=>subscribe('lifetime')} loading={subLoading==='lifetime'}>Get Lifetime Access</Btn>
        </div>
        <div className="bg-white/10 rounded-2xl p-5 mb-6">
          <p className="font-black text-white text-sm mb-0.5">Monthly Plan</p>
          <div className="flex items-baseline gap-1 mb-1">
            <span className="text-3xl font-black text-white">£7.99</span>
            <span className="text-white/40 text-sm">/month</span>
          </div>
          <p className="text-xs text-white/40 mb-4">Cancel any time.</p>
          <Btn variant="outline" onClick={()=>subscribe('monthly')} loading={subLoading==='monthly'}>Subscribe Monthly</Btn>
        </div>
        <p className="text-center text-white/25 text-xs leading-relaxed">Your data is safe and waiting.</p>
      </div>
    </div>
  );
};

// ── APP ───────────────────────────────────────────────────────────────────────
const App = () => {
  const [session,setSession]=useState(null);
  const [profile,setProfile]=useState(null);
  const [screen,setScreen]=useState('dashboard');
  const [appLoading,setAppLoading]=useState(true);
  const [showOnboarding,setShowOnboarding]=useState(false);
  const [showHelp,setShowHelp]=useState(false);
  const [recoveryToken,setRecoveryToken]=useState(null);
  const [checkoutFlash,setCheckoutFlash]=useState('');
  const [showLanding,setShowLanding]=useState(true);
  const [authMode,setAuthMode]=useState('register');

  useEffect(()=>{
    const qs=new URLSearchParams(window.location.search);
    // Store referral code for use at sign-up
    const ref=qs.get('ref');
    if(ref) localStorage.setItem('vg_ref',ref);
    if(qs.get('checkout')==='success'){
      setCheckoutFlash('success');
      setScreen('account');
      window.history.replaceState(null,'',window.location.pathname);
    } else if(qs.get('checkout')==='cancelled'){
      setCheckoutFlash('cancelled');
      window.history.replaceState(null,'',window.location.pathname);
    }
    const hash=window.location.hash;
    if(hash.includes('type=recovery')&&hash.includes('access_token')){
      const params=new URLSearchParams(hash.slice(1));
      const token=params.get('access_token');
      if(token){setRecoveryToken(token);window.history.replaceState(null,'',window.location.pathname);setAppLoading(false);return;}
    }
    sb.auth.getSession().then(({data:{session}})=>{
      setSession(session);
      if(session) loadProfile(session.user.id);
      else setAppLoading(false);
    }).catch(()=>setAppLoading(false));
    const {data:{subscription}}=sb.auth.onAuthStateChange(async(_e,session)=>{
      setSession(session);
      if(session) loadProfile(session.user.id);
      else {setProfile(null);setShowLanding(true);setAppLoading(false);}
    });
    const IDLE_MS=30*60*1000;
    let idleTimer=null;
    const resetIdle=()=>{
      clearTimeout(idleTimer);
      idleTimer=setTimeout(()=>{ sb.auth.signOut(); },IDLE_MS);
    };
    const events=['mousemove','mousedown','touchstart','keydown','scroll'];
    events.forEach(e=>window.addEventListener(e,resetIdle,{passive:true}));
    resetIdle();
    return ()=>{
      subscription.unsubscribe();
      clearTimeout(idleTimer);
      events.forEach(e=>window.removeEventListener(e,resetIdle));
    };
  },[]);

  const loadProfile=async(userId)=>{
    try{
      const timeout=new Promise((_,rej)=>setTimeout(()=>rej(new Error('timeout')),8000));
      const{data}=await Promise.race([
        sb.from('profiles').select('*').eq('id',userId).maybeSingle(),
        timeout
      ]);
      setProfile(data);
      const obDone=localStorage.getItem('vg_ob_'+userId);
      if(!data?.unit_type && !obDone){
        setShowOnboarding(true);
      } else {
        localStorage.setItem('vg_ob_'+userId,'1');
      }
    } catch(e){
      console.error('loadProfile error:',e);
      _saveS(null);
      setSession(null);
    } finally {
      setAppLoading(false);
    }
  };

  if(appLoading) return (
    <div className="min-h-screen bg-navy flex flex-col items-center justify-center gap-5">
      <img src="/icon-192.png" className="w-24 h-24 rounded-3xl shadow-2xl" alt="VanGuard" style={{borderRadius:'22px'}}/>
      <div>
        <p className="text-white font-black text-2xl text-center leading-none">Van<span className="text-teal">Guard</span></p>
        <p className="text-white/30 text-xs text-center mt-1 uppercase tracking-widest">Stay compliant. Keep moving.</p>
      </div>
      <div className="w-6 h-6 border-2 border-white/20 border-t-white rounded-full animate-spin"/>
    </div>
  );

  if(recoveryToken) return <ResetPasswordScreen token={recoveryToken} onDone={()=>setRecoveryToken(null)}/>;
  if(!session) return showLanding
    ? <LandingPage onGetStarted={(m)=>{setAuthMode(m);setShowLanding(false);}}/>
    : <AuthScreen initialMode={authMode} onBack={()=>setShowLanding(true)}/>;

  if(!session?.user?.id){_saveS(null);setSession(null);return null;}
  const userId=session.user.id;

  if(showOnboarding) return (
    <OnboardingWizard userId={userId} profile={profile} onComplete={p=>{localStorage.setItem('vg_ob_'+userId,'1');setProfile(p);setShowOnboarding(false);}}/>
  );

  const isActive=profile?.subscription_status==='active';
  const isLifetime=profile?.subscription_status==='lifetime';
  const trialDays=profile?.trial_start?Math.floor((new Date()-new Date(profile.trial_start))/86400000):0;
  const trialLeft=(isActive||isLifetime)?0:Math.max(0,14-trialDays);
  const isExpired=!!(profile&&!isActive&&!isLifetime&&profile.trial_start&&trialDays>=14);

  return (
    <div className="max-w-lg mx-auto relative min-h-screen">
      <OfflineBanner/>
      <TopNav screen={screen} onChange={setScreen} profile={profile}/>
      <TrialBanner trialLeft={trialLeft} onUpgrade={()=>setScreen('account')}/>
      {checkoutFlash==='success'&&<div className="fixed left-0 right-0 z-40 max-w-lg mx-auto px-4 pt-3" style={{top:trialLeft>0&&trialLeft<=7?'96px':'56px'}}>
        <div className="bg-green-500 text-white text-sm font-semibold px-4 py-3 rounded-xl flex items-center justify-between shadow-lg">
          <span>Subscription active!</span>
          <button onClick={()=>setCheckoutFlash('')} className="ml-3 opacity-70 text-lg leading-none">x</button>
        </div>
      </div>}
      {checkoutFlash==='cancelled'&&<div className="fixed top-14 left-0 right-0 z-40 max-w-lg mx-auto px-4 pt-3">
        <div className="bg-gray-600 text-white text-sm px-4 py-3 rounded-xl flex items-center justify-between shadow-lg">
          <span>Checkout cancelled.</span>
          <button onClick={()=>setCheckoutFlash('')} className="ml-3 opacity-70 text-lg leading-none">x</button>
        </div>
      </div>}
      {isExpired&&screen!=='account'?(
        <PaywallScreen userId={userId} profile={profile}/>
      ):(
        <>
          {screen==='dashboard'&&<Dashboard profile={profile} userId={userId} onNav={setScreen}/>}
          {screen==='diary'&&<DiaryScreen userId={userId} profile={profile}/>}
          {screen==='temp'&&<TempScreen userId={userId}/>}
          {screen==='van'&&<VanScreen userId={userId} profile={profile}/>}
          {screen==='records'&&<RecordsScreen userId={userId} profile={profile}/>}
          {screen==='account'&&<AccountScreen userId={userId} profile={profile} onUpdate={p=>{setProfile(p);}}/>}
        </>
      )}
      <HelpFab onClick={()=>setShowHelp(true)}/>
      <HelpDrawer screen={screen} open={showHelp} onClose={()=>setShowHelp(false)}/>
      <InstallPrompt userId={userId}/>
    </div>
  );
};

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</textarea>
<script>
function _showErr(msg){
  var r=document.getElementById('root');
  if(r) r.innerHTML='<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;background:#1A2744;padding:24px;text-align:center"><p style="color:#ef4444;font-family:monospace;font-size:12px;white-space:pre-wrap;max-width:400px;word-break:break-all">'+String(msg).slice(0,600)+'</p></div>';
}
document.addEventListener('DOMContentLoaded',function(){
  try {
    var src=document.getElementById('__app__').value;
    var result=Babel.transform(src,{presets:[['react',{runtime:'classic'}]]});
    var s=document.createElement('script');
    s.textContent=result.code;
    document.body.appendChild(s);
  } catch(e) {
    _showErr(e.stack||e.message);
  }
});
if('serviceWorker' in navigator){
  window.addEventListener('load',function(){
    navigator.serviceWorker.register('/sw.js').catch(function(){});
  });
}
</script>
</body>
</html>
