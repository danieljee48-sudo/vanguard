// ── START TRIAL SCREEN (card required before first use) ──────────────────────
const StartTrialScreen=({userId,email,onLogout})=>{
  const [loading,setLoading]=useState(false);
  const [err,setErr]=useState('');
  const [plan,setPlan]=useState('monthly');
  const startTrial=async()=>{
    setErr(''); setLoading(true);
    try{
      const tok=_getS()?.access_token;
      const res=await fetch('/.netlify/functions/create-checkout',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},
        body:JSON.stringify({userId,email,trial:true,plan}),
      });
      const{url,error}=await res.json();
      if(error) throw new Error(error);
      window.location.href=url;
    }catch(e){setErr('Could not start your trial: '+e.message);setLoading(false);}
  };
  return (
    <div className="min-h-screen bg-navy flex flex-col items-center justify-center p-5 pt-16">
      <div className="w-full max-w-sm fade-in">
        <div className="text-center mb-7">
          <img src="/icon-192.png" className="w-16 h-16 mx-auto rounded-2xl shadow-2xl mb-4" alt="VanGuard" style={{borderRadius:'18px'}}/>
          <h1 className="text-2xl font-black text-white leading-tight">Start your<br/>14-day free trial</h1>
          <p className="text-white/50 text-sm mt-2 leading-relaxed">Full access to every feature. We'll take your card to hold your place — you won't be charged until day 15.</p>
        </div>
        <div className="bg-white rounded-2xl p-5 mb-4">
