        {/* Reassurance */}
        <div className="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
          <p className="text-xs font-bold tracking-wider mb-3 text-gray-400">WHAT YOU GET</p>
          <div className="flex items-end gap-1 mb-1">
            <span className="text-3xl font-black" style={{color:'#1A2744'}}>Everything</span>
          </div>
