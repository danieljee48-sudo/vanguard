              {[
                ['Survives a rainy market day','✗','✓'],
                ['Auto-timestamps every entry','✗','✓'],
                ['Flags a failed temp reading instantly','✗','✓'],
                ['Export a full inspection pack in one tap','✗','✓'],
                ['Morning reminder to log your checks','✗','✓'],
                ['Works on any phone, nothing to install','✗','✓'],
              ].map(([label,...cells],i)=>(
                <tr key={label} style={{background:i%2===0?'white':'#F8FAFB'}}>
                  <td className="py-3 px-4 text-gray-600 text-xs">{label}</td>
                  {cells.map((c,j)=>(
                    <td key={j} className={`py-3 px-2 text-center text-xs font-semibold ${c==='✓'?'text-teal':c==='✗'?'text-red-400':'text-gray-400'}`}>{c}</td>
                  ))}
