          <p className="text-xs text-gray-400">Card details taken to start your trial · Cancel anytime · No long contracts</p>
        </div>
      </div>

      {/* ── COMPARISON ── */}
      <div className="px-5 py-10">
        <h2 className="text-xl font-black text-center mb-2" style={{color:'#1A2744'}}>VanGuard vs. paper records.</h2>
        <p className="text-center text-xs text-gray-400 mb-6">Most mobile caterers still use clipboards. Here's what that costs you.</p>
        <div className="rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
          <table className="w-full text-sm">
            <thead>
              <tr style={{background:'#1A2744'}}>
                <th className="text-left py-3 px-4 text-white/60 font-medium text-xs"></th>
                <th className="py-3 px-2 text-white/40 font-medium text-xs">Paper</th>
                <th className="py-3 px-2 text-white font-bold text-xs">VanGuard</th>
              </tr>
            </thead>
