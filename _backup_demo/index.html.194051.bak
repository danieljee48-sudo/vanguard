<textarea id="__app__" style="position:absolute;left:-9999px;visibility:hidden">
/** @jsxRuntime classic */
const { useState, useEffect, useRef } = React;

// ── SUPABASE MINI-CLIENT ──────────────────────────────────────────────────────
const SUPA_URL = 'https://qzzwkxborlmmyaukvhga.supabase.co';
const SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF6endreGJvcmxtbXlhdWt2aGdhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxNjM2MTUsImV4cCI6MjA5NzczOTYxNX0.CmI0bEHPpVUIxZIU7F1tdDAwN1vLryd8QqRny7ig3mk';
const VAPID_PUBLIC_KEY='BH3NTRSAJFv7P_APz14gT2TPvD963aU9fejfAeI0WfZERYOLIZr08V5GwVX-0H7Utp0dXYqgnryviaE3C4pNFSo';
const urlBase64ToUint8=s=>{const p=(s+'===').slice(0,s.length+((4-s.length%4)%4)).replace(/-/g,'+').replace(/_/g,'/');const r=atob(p);return Uint8Array.from(r,c=>c.charCodeAt(0));}
const _SK = 'vg_session';
const _getS = () => {
  try {
    const ss=sessionStorage.getItem(_SK);
    if(ss) return JSON.parse(ss);
    // Migrate any existing localStorage session into sessionStorage, then clear it
    const ls=localStorage.getItem(_SK);
    if(ls){ sessionStorage.setItem(_SK,ls); localStorage.removeItem(_SK); return JSON.parse(ls); }
    return null;
  } catch { return null; }
};
const _saveS = s => {
  if(s) sessionStorage.setItem(_SK,JSON.stringify(s));
  else sessionStorage.removeItem(_SK);
  localStorage.removeItem(_SK); // always wipe any lingering localStorage copy
};
const _ls = [];
const _h = tok => ({ 'apikey': SUPA_KEY, 'Content-Type': 'application/json', 'Authorization': `Bearer ${tok || SUPA_KEY}` });

class _Q {
  constructor(t, tok) { this.t=t; this.tok=tok; this.f=[]; this.cols='*'; this.ord=null; this.lim=null; this.cnt=false; this.hd=false; this.sg=false; this.mb=false; }
  select(c='*', o={}) { this.cols=c; if(o.count) this.cnt=true; if(o.head) this.hd=true; return this; }
  eq(c,v) { this.f.push(`${c}=eq.${encodeURIComponent(v)}`); return this; }
  gte(c,v) { this.f.push(`${c}=gte.${encodeURIComponent(v)}`); return this; }
  order(c,{ascending=true}={}) { this.ord=`${c}.${ascending?'asc':'desc'}`; return this; }
  limit(n) { this.lim=n; return this; }
  single() { this.sg=true; return this; }
  maybeSingle() { this.mb=true; return this; }
  async _run() {
    if(window.__vgDemo) return _vgDemoQuery(this);
    let url=`${SUPA_URL}/rest/v1/${this.t}?select=${this.cols}`;
    this.f.forEach(x=>url+=`&${x}`);
    if(this.ord) url+=`&order=${this.ord}`;
    if(this.cnt||this.hd) {
      const r=await fetch(url,{method:'HEAD',headers:{..._h(this.tok),'Prefer':'count=exact'}});
      const count=parseInt((r.headers.get('content-range')||'0/0').split('/')[1])||0;
      return {count,data:null,error:null};
    }
    if(this.mb) {
      const r=await fetch(url+'&limit=1',{headers:_h(this.tok)});
      const arr=await r.json().catch(()=>[]);
      return {data:Array.isArray(arr)?(arr[0]||null):null,error:null};
    }
    if(this.lim) url+=`&limit=${this.lim}`;
    const h={..._h(this.tok)};
    if(this.sg) h['Accept']='application/vnd.pgrst.object+json';
    const r=await fetch(url,{headers:h});
    const data=await r.json().catch(()=>null);
    if(data&&data.code) return {data:null,error:data};
    return {data,error:null};
  }
  then(res,rej) { return this._run().then(res,rej); }
}

class _U {
  constructor(t,tok,d) { this.t=t; this.tok=tok; this.d=d; this.f=[]; this.ret='minimal'; this.sg=false; }
  eq(c,v) { this.f.push(`${c}=eq.${encodeURIComponent(v)}`); return this; }
  select() { this.ret='representation'; return this; }
  single() { this.sg=true; return this; }
  async _run() {
    if(window.__vgDemo){ const merged={...DEMO_PROFILE,...this.d}; return {data:this.sg?merged:(this.ret==='representation'?[merged]:null),error:null}; }
    let url=`${SUPA_URL}/rest/v1/${this.t}?${this.f.join('&')}`;
    const h={..._h(this.tok),'Prefer':`return=${this.ret}`};
    if(this.sg) h['Accept']='application/vnd.pgrst.object+json';
    const r=await fetch(url,{method:'PATCH',headers:h,body:JSON.stringify(this.d)});
    const text=await r.text();
    if(!text||!text.trim()) return {data:null,error:null};
    const data=JSON.parse(text);
    return {data,error:null};
  }
  then(res,rej) { return this._run().then(res,rej); }
}

// ── DEMO MODE (fully client-side sample account) ──────────────────────────────
// When window.__vgDemo is true, the sb data layer returns canned sample rows and
// treats all writes as successful no-ops. No real accounts or Supabase writes.
const _DEMO_UID='demo-user';
const _DEMO_PROFILE={
  id:_DEMO_UID, name:'Sam Rivera', business_name:'The Demo Kitchen',
  email:'sam@thedemokitchen.example', unit_type:'van', authority:'Bristol City Council',
  lpg_enabled:true, water_enabled:true, subscription_status:'trialing',
  trial_start:new Date().toISOString().slice(0,10), onboarded:true,
  hygiene_rating:5, plan_interval:'month', food_type:'Street food',
  team_size:2, stripe_customer_id:null,
};
const _demoBuild=()=>{
  if(window.__vgDemoData) return window.__vgDemoData;
  const t=Date.now();
  const D=[];for(let i=0;i<6;i++)D.push(new Date(t-i*86400000).toISOString().slice(0,10));
  const p2=n=>('0'+n).slice(-2);
  const iso=(d,h,m)=>d+'T'+p2(h)+':'+p2(m)+':00+00:00';
  const full=n=>{const o={};for(let i=0;i<n;i++)o[i]=true;return o;};
  const locs=['Borough Market, London','Ropewalk, Bristol','Kings Cross, London','Camden Lock, London','Brick Lane, London','Greenwich Market'];
  const diaries=D.map((d,i)=>({id:'demo-diary-'+i,user_id:_DEMO_UID,date:d,location:locs[i%locs.length],opening:full(4),closing:full(4),issues:i===2?'Fridge 1 slightly warm at open (9°C) — adjusted thermostat, back to 4°C within 20 min.':'',created_at:iso(d,8,15)}));
  const temps=[];
  D.forEach((d,di)=>{
    const appl=[{unit:'Fridge 1',type:'cold',th:8,am:4,pm:5},{unit:'Freezer',type:'cold',th:-18,am:-19,pm:-18},{unit:'Hot Hold',type:'hot',th:63,am:71,pm:67}];
    appl.forEach((r,ri)=>{
      [{h:9,m:5,v:r.am},{h:15,m:30,v:r.pm}].forEach((slot,si)=>{
        let temp=slot.v, action=null;
        if(di===3&&ri===2&&si===0) temp=58; // one instructive failed hot-hold reading + corrective action
        const pass=r.type==='cold'?temp<=r.th:temp>=r.th;
        if(!pass) action='Reheated to 75°C and held above 63°C — re-checked OK.';
        temps.push({id:'demo-temp-'+di+'-'+ri+'-'+si,user_id:_DEMO_UID,date:d,time:p2(slot.h)+':'+p2(slot.m),unit:r.unit,type:r.type,threshold:r.th,temp,pass,action,created_at:iso(d,slot.h,slot.m)});
      });
    });
  });
  const cleaning_logs=D.map((d,i)=>({id:'demo-clean-'+i,user_id:_DEMO_UID,date:d,checks:full(8),saved_by:'Sam Rivera',created_at:iso(d,16,45)}));
  const van_checks=D.map((d,i)=>({id:'demo-van-'+i,user_id:_DEMO_UID,date:d,checks:full(8),signed_by:'Sam Rivera',created_at:iso(d,8,30)}));
  const lpg_logs=D.slice(0,5).map((d,i)=>({id:'demo-lpg-'+i,user_id:_DEMO_UID,date:d,hose:true,reg:true,flame:true,leak:true,notes:i===0?'Leak-tested all joints with detergent spray — no bubbles.':'',created_at:iso(d,8,20)}));
  const water_logs=D.slice(0,3).map((d,i)=>({id:'demo-water-'+i,user_id:_DEMO_UID,date:d,filled:true,cleaned:true,san:true,sanitised:true,created_at:iso(d,8,25)}));
  const pNames=['Borough Market','Ropewalk','Kings Cross','Camden Lock','Brick Lane','Greenwich Market'];
  const pAddrs=['8 Southwark St, London SE1','Ropewalk, Bristol BS1','Kings Blvd, London N1C','Camden Lock Pl, London NW1','91 Brick Ln, London E1','Greenwich, London SE10'];
  const pitch_logs=D.map((d,i)=>({id:'demo-pitch-'+i,user_id:_DEMO_UID,date:d,name:pNames[i%6],address:pAddrs[i%6],created_at:iso(d,7,50)}));
  const data={profiles:[_DEMO_PROFILE],diaries,temp_logs:temps,cleaning_logs,van_checks,lpg_logs,water_logs,pitch_logs,feedback:[]};
  window.__vgDemoData=data;
  return data;
};
class _DemoQ {
  constructor(t){this.t=t;this.rows=(_demoBuild()[t]||[]).map(x=>x);this.cnt=false;this.hd=false;this.sg=false;this.mb=false;this._lim=null;}
  select(c='*',o){o=o||{};if(o.count)this.cnt=true;if(o.head)this.hd=true;return this;}
  eq(c,v){this.rows=this.rows.filter(r=>String(r[c])===String(v));return this;}
  gte(c,v){this.rows=this.rows.filter(r=>String(r[c])>=String(v));return this;}
  order(c,o){const asc=!(o&&o.ascending===false);this.rows=this.rows.slice().sort((a,b)=>a[c]===b[c]?0:(a[c]>b[c]?1:-1)*(asc?1:-1));return this;}
  limit(n){this._lim=n;return this;}
  single(){this.sg=true;return this;}
  maybeSingle(){this.mb=true;return this;}
  _run(){let rows=this.rows;if(this._lim!=null)rows=rows.slice(0,this._lim);if(this.cnt||this.hd)return Promise.resolve({count:rows.length,data:null,error:null});if(this.mb||this.sg)return Promise.resolve({data:rows[0]||null,error:null});return Promise.resolve({data:rows,error:null});}
  then(res,rej){return this._run().then(res,rej);}
}
class _DemoU {
  constructor(t){this.t=t;}
  eq(){return this;} select(){return this;} single(){return this;}
  _run(){return Promise.resolve({data:this.t==='profiles'?_DEMO_PROFILE:null,error:null});}
  then(res,rej){return this._run().then(res,rej);}
}
const _demoFrom=table=>({
  select:(c,o)=>new _DemoQ(table).select(c,o),
  insert:async()=>({data:null,error:null}),
  upsert:async()=>({data:null,error:null}),
  update:()=>new _DemoU(table),
});

const sb = {
  auth: {
    getSession: async () => ({data:{session:_getS()},error:null}),
    signUp: async ({email,password,options}) => {
      // Pass name/business/referral as user_metadata so the DB trigger populates the
      // profile reliably — works whether or not email confirmation is on.
      const r=await fetch(`${SUPA_URL}/auth/v1/signup`,{method:'POST',headers:{'apikey':SUPA_KEY,'Content-Type':'application/json'},body:JSON.stringify({email,password,data:options?.data||{}})});
      const d=await r.json();
      if(!r.ok || d.error || d.error_description || (d.msg && !d.id && !d.access_token)){
        return {error:{message:d.error_description||d.msg||d.message||'Sign up failed. Please try again.'}};
      }
      const uid=d.user?.id||d.id;
      // Email confirmation ON → no session yet. Profile is created by the trigger.
      if(!d.access_token){
        return {data:{session:null,user:d.user||d},error:null};
      }
      // Autoconfirm → we have a session. (Trigger also creates the profile; this is a safe fallback.)
      await fetch(`${SUPA_URL}/rest/v1/profiles`,{method:'POST',headers:{..._h(d.access_token),'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({id:uid,name:options?.data?.name,business_name:options?.data?.businessName})}).catch(()=>{});
      fetch('/.netlify/functions/send-welcome',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({firstName:options?.data?.name,email:(d.user||d).email})}).catch(()=>{});
      const s={access_token:d.access_token,refresh_token:d.refresh_token,user:d.user||d};
      _saveS(s); _ls.forEach(fn=>fn('SIGNED_IN',s));
      return {data:{session:s},error:null};
    },
    signInWithPassword: async ({email,password}) => {
      const r=await fetch(`${SUPA_URL}/auth/v1/token?grant_type=password`,{method:'POST',headers:{'apikey':SUPA_KEY,'Content-Type':'application/json'},body:JSON.stringify({email,password})});
      const d=await r.json();
      if(!d.access_token) return {error:{message:d.error_description||d.msg||'Incorrect email or password'}};
      const s={access_token:d.access_token,refresh_token:d.refresh_token,user:d.user};
      _saveS(s); _ls.forEach(fn=>fn('SIGNED_IN',s));
      return {data:{session:s},error:null};
    },
    signOut: async () => {
      const s=_getS();
      if(s?.access_token) await fetch(`${SUPA_URL}/auth/v1/logout`,{method:'POST',headers:{'apikey':SUPA_KEY,'Authorization':`Bearer ${s.access_token}`}}).catch(()=>{});
      _saveS(null); _ls.forEach(fn=>fn('SIGNED_OUT',null));
      return {error:null};
    },
    updatePassword: async (newPassword) => {
      const s=_getS();
      if(!s?.access_token) return {error:{message:'Not signed in'}};
      const r=await fetch(`${SUPA_URL}/auth/v1/user`,{method:'PUT',headers:{..._h(s.access_token)},body:JSON.stringify({password:newPassword})});
      const d=await r.json();
      if(d.error||d.code>=400) return {error:{message:d.message||'Failed to update password'}};
      return {data:d,error:null};
    },
    resetPassword: async (email) => {
      const r=await fetch(`${SUPA_URL}/auth/v1/recover`,{method:'POST',headers:{'apikey':SUPA_KEY,'Content-Type':'application/json'},body:JSON.stringify({email})});
      return r.ok?{error:null}:{error:{message:'Could not send reset email. Please check your email address.'}};
    },
    onAuthStateChange: cb => { _ls.push(cb); return {data:{subscription:{unsubscribe:()=>{const i=_ls.indexOf(cb);if(i>-1)_ls.splice(i,1);}}}}; }
  },
  from: table => {
    if(typeof window!=='undefined'&&window.__vgDemo) return _demoFrom(table);
    const tok=_getS()?.access_token;
    return {
      select:(c,o)=>new _Q(table,tok).select(c,o),
      insert:async d=>{if(window.__vgDemo)return{data:null,error:null};try{const r=await fetch(`${SUPA_URL}/rest/v1/${table}`,{method:'POST',headers:{..._h(tok),'Prefer':'return=minimal'},body:JSON.stringify(d)});return r.ok?{data:null,error:null}:{data:null,error:await r.json()};}catch{if(!navigator.onLine){_addQ({table,data:d,tok,prefer:'return=minimal'});return{data:null,error:null,offline:true};}return{data:null,error:{message:'Network error'}};}},
      upsert:async d=>{if(window.__vgDemo)return{data:null,error:null};try{const r=await fetch(`${SUPA_URL}/rest/v1/${table}`,{method:'POST',headers:{..._h(tok),'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify(d)});return r.ok?{data:null,error:null}:{data:null,error:await r.json()};}catch{if(!navigator.onLine){_addQ({table,data:d,tok,prefer:'resolution=merge-duplicates,return=minimal'});return{data:null,error:null,offline:true};}return{data:null,error:{message:'Network error'}};}},
      update:d=>new _U(table,tok,d),
    };
  }
};

// ── OFFLINE QUEUE ─────────────────────────────────────────────────────────────
const _OQ_KEY='vg_offline_queue';
const _getQ=()=>{try{return JSON.parse(localStorage.getItem(_OQ_KEY)||'[]');}catch{return[];}};
const _saveQ=q=>localStorage.setItem(_OQ_KEY,JSON.stringify(q));
const _addQ=item=>{const q=_getQ();q.push({...item,qid:Date.now()+Math.random().toString(36).slice(2)});_saveQ(q);};
const replayOfflineQueue=async()=>{
  const q=_getQ();
  if(!q.length) return 0;
  const remain=[];
  for(const item of q){
    try{
      const tok=_getS()?.access_token||item.tok;
      const heads={..._h(tok)};
      if(item.prefer) heads['Prefer']=item.prefer;
      const r=await fetch(`${SUPA_URL}/rest/v1/${item.table}`,{method:'POST',headers:heads,body:JSON.stringify(item.data)});
      if(!r.ok) remain.push(item);
    }catch{remain.push(item);}
  }
  _saveQ(remain);
  return q.length-remain.length;
};

// ── DEMO MODE (client-side sandbox account — no real accounts / no DB writes) ──
// Entered via ?demo=1 or the "Take a look inside" controls. When window.__vgDemo
// is true, the sb data layer below short-circuits: reads return canned sample
// rows and writes are success no-ops, so a prospective user can click around a
// realistic account before signing up.
if (typeof window !== 'undefined') {
  try { if (new URLSearchParams(window.location.search).get('demo') === '1') window.__vgDemo = true; } catch (e) {}
}
const DEMO_UID = 'demo-user-0000';
const DEMO_PROFILE = {
  id: DEMO_UID,
  email: 'sam@thedemokitchen.example',
  name: 'Sam Rivera',
  business_name: 'The Demo Kitchen',
  unit_type: 'van',
  authority: 'Bristol City Council',
  lpg_enabled: true,
  water_enabled: true,
  team_size: 2,
  food_type: 'Street food',
  subscription_status: 'trialing',
  trial_start: new Date().toISOString().slice(0,10),
  onboarded: true,
  hygiene_rating: 5,
  plan_interval: 'month',
  stripe_customer_id: null,
  custom_checklists: null,
  cancel_at_period_end: false,
  period_end: null,
};
// Build (once) a realistic set of recent rows across every table the app reads.
function _demoRows() {
  if (window.__vgRows) return window.__vgRows;
  const d = n => new Date(Date.now() - n*864e5).toISOString().slice(0,10);
  const ts = (day,h,m) => day + 'T' + String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':00.000Z';
  const allTrue = n => { const o = {}; for (let i=0;i<n;i++) o[i]=true; return o; };
  const diaries=[], temp_logs=[], cleaning_logs=[], van_checks=[], lpg_logs=[], water_logs=[], pitch_logs=[];
  const locs=['Bristol Harbourside Market','Clifton Food Fair','Bath Farmers Market','Corn Street Market','Bedminster Market','Wapping Wharf','Ashton Court'];
  for (let i=0;i<7;i++) {
    const day = d(i);
    diaries.push({ id:'diary-'+i, user_id:DEMO_UID, date:day, location:locs[i%locs.length], opening:allTrue(4), closing:allTrue(4), issues: i===2?'Main fridge read slightly warm at midday — moved high-risk stock to the cool box and re-checked once settled.':'', created_at: ts(day,7,30) });
    cleaning_logs.push({ id:'clean-'+i, user_id:DEMO_UID, date:day, checks:allTrue(8), saved_by:'Sam Rivera', created_at: ts(day,17,10) });
    van_checks.push({ id:'van-'+i, user_id:DEMO_UID, date:day, checks:allTrue(8), signed_by:'Sam Rivera', created_at: ts(day,7,15) });
    const fridge = Number((2.4 + (i%3)*0.6).toFixed(1));
    const freezer = Number((-19 + (i%2)).toFixed(1));
    const hot = Number((74 + (i%3)).toFixed(1));
    temp_logs.push({ id:'temp-'+i+'a', user_id:DEMO_UID, date:day, time:'08:05', unit:'Main fridge', temp:fridge, type:'fridge', threshold:5, pass:true, action:null, created_at: ts(day,8,5) });
    temp_logs.push({ id:'temp-'+i+'b', user_id:DEMO_UID, date:day, time:'12:30', unit:'Chest freezer', temp:freezer, type:'freezer', threshold:-18, pass:true, action:null, created_at: ts(day,12,30) });
    if (i%2===0) temp_logs.push({ id:'temp-'+i+'c', user_id:DEMO_UID, date:day, time:'13:00', unit:'Hot hold — chilli', temp:hot, type:'hot', threshold:63, pass:true, action:null, created_at: ts(day,13,0) });
  }
  // One older failed-then-corrected reading, to show how a fail + corrective action looks.
  temp_logs.push({ id:'temp-old-fail', user_id:DEMO_UID, date:d(9), time:'11:15', unit:'Main fridge', temp:7.8, type:'fridge', threshold:5, pass:false, action:'Adjusted thermostat, moved high-risk stock to cool box, re-checked at 11:45 (3.9°C — pass).', created_at: ts(d(9),11,15) });
  lpg_logs.push({ id:'lpg-0', user_id:DEMO_UID, date:d(3), hose:true, reg:true, flame:true, leak:true, notes:'Bubble test on all joints — no leaks. Regulator and hose in good condition.', created_at: ts(d(3),7,0) });
  lpg_logs.push({ id:'lpg-1', user_id:DEMO_UID, date:d(24), hose:true, reg:true, flame:true, leak:true, notes:'Monthly gas safety check — all clear.', created_at: ts(d(24),7,0) });
  water_logs.push({ id:'water-0', user_id:DEMO_UID, date:d(0), filled:true, cleaned:true, san:true, sanitised:true, created_at: ts(d(0),7,20) });
  water_logs.push({ id:'water-1', user_id:DEMO_UID, date:d(2), filled:true, cleaned:true, san:false, sanitised:false, created_at: ts(d(2),7,20) });
  pitch_logs.push({ id:'pitch-0', user_id:DEMO_UID, date:d(0), name:'Bristol Harbourside Market', address:'Harbourside, Bristol BS1 5DB', created_at: ts(d(0),7,0) });
  pitch_logs.push({ id:'pitch-1', user_id:DEMO_UID, date:d(1), name:'Clifton Food Fair', address:'Clifton Down, Bristol BS8 3HR', created_at: ts(d(1),7,0) });
  pitch_logs.push({ id:'pitch-2', user_id:DEMO_UID, date:d(4), name:'Bath Farmers Market', address:'Green Park Station, Bath BA1 1JB', created_at: ts(d(4),7,0) });
  window.__vgRows = { profiles:[DEMO_PROFILE], diaries, temp_logs, cleaning_logs, van_checks, lpg_logs, water_logs, pitch_logs, feedback:[] };
  return window.__vgRows;
}
// Apply a _Q query builder's filters/order/limit against the canned rows.
function _vgDemoQuery(q) {
  let out = (_demoRows()[q.t] || []).slice();
  out = out.filter(r => (q.f||[]).every(f => {
    const eq = f.indexOf('='); if (eq < 0) return true;
    const col = f.slice(0, eq);
    const rest = f.slice(eq+1);
    const dot = rest.indexOf('.'); if (dot < 0) return true;
    const op = rest.slice(0, dot);
    const val = decodeURIComponent(rest.slice(dot+1));
    const rv = r[col];
    switch (op) {
      case 'eq': return String(rv) === val;
      case 'neq': return String(rv) !== val;
      case 'gte': return String(rv) >= val;
      case 'gt': return String(rv) > val;
      case 'lte': return String(rv) <= val;
      case 'lt': return String(rv) < val;
      default: return true;
    }
  }));
  if (q.ord) {
    const [col, dir] = q.ord.split('.');
    out.sort((a,b) => { const av=a[col], bv=b[col]; if (av<bv) return dir==='desc'?1:-1; if (av>bv) return dir==='desc'?-1:1; return 0; });
  }
  if (q.cnt || q.hd) return { count: out.length, data: null, error: null };
  if (q.lim) out = out.slice(0, q.lim);
  if (q.mb) return { data: out[0] || null, error: null };
  if (q.sg) return { data: out[0] || null, error: null };
  return { data: out, error: null };
}

