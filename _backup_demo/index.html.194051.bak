        <h2 className="text-2xl font-black text-white mb-3">Ready to go paperless?</h2>
        <p className="text-white/50 text-sm mb-6">Join mobile caterers already using VanGuard to stay compliant.</p>
        <button onClick={()=>onGetStarted('register')}
          className="w-full max-w-xs mx-auto block font-bold text-white py-4 rounded-2xl text-base mb-3 shadow-lg"
          style={{background:'#0D7377'}}>
          Start Your Free Trial
