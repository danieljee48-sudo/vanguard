      {/* ── FOOTER ── */}
      <div className="px-5 py-6 text-center border-t border-gray-100">
        <p className="text-xs text-gray-300 mb-1">© 2026 VanGuard · Food safety for UK mobile caterers</p>
        <p className="text-xs text-gray-300">
          <a href="mailto:hello@vanguardapp.co.uk" style={{color:'#0D7377'}}>Contact & support</a>
          {' · '}
          <a href="/privacy.html" style={{color:'#0D7377'}}>Privacy</a>
          {' · '}
          <a href="/terms.html" style={{color:'#0D7377'}}>Terms</a>
        </p>
      </div>

    </div>
  );
};

// ── AUTH SCREEN ───────────────────────────────────────────────────────────────
const AuthScreen = ({initialMode='login', onBack=null}) => {
  const [mode,setMode]=useState(initialMode); // 'login' | 'register' | 'forgot'
  const [email,setEmail]=useState('');
  const [pass,setPass]=useState('');
  const [name,setName]=useState('');
  const [biz,setBiz]=useState('');
  const [err,setErr]=useState('');
  const [ok,setOk]=useState('');
  const [loading,setLoading]=useState(false);
  const submit=async()=>{
    setErr(''); setOk(''); setLoading(true);
    if(mode==='forgot'){
      if(!email){setErr('Please enter your email address.');setLoading(false);return;}
      const {error}=await sb.auth.resetPassword(email);
      if(error){setErr(error.message);}else{setOk('Reset link sent! Check your inbox.');}
      setLoading(false); return;
    }
    if(mode==='register'){
      if(!name||!biz||!email||!pass){setErr('Please fill in all fields.');setLoading(false);return;}
      try{
        const refCode=new URLSearchParams(window.location.search).get('ref')||localStorage.getItem('vg_ref')||null;
        const {error,data:signUpData}=await sb.auth.signUp({email,password:pass,options:{data:{name,businessName:biz,referred_by:refCode}}});
        if(refCode) localStorage.removeItem('vg_ref');
        if(error){setErr(error.message);setLoading(false);return;}
        // If email confirmation is required, no session is returned. Tell the user
        // instead of leaving the button spinning forever.
        if(!signUpData?.session){
          setOk('Account created! Check your inbox to confirm your email, then sign in.');
          setMode('login');setPass('');setLoading(false);return;
        }
        // Otherwise onAuthStateChange will take over and load the app.
      }catch(e){setErr('Sign up failed. Please try again.');setLoading(false);}
    } else {
      if(!email||!pass){setErr('Please fill in all fields.');setLoading(false);return;}
      try{
        const {error}=await sb.auth.signInWithPassword({email,password:pass});
        if(error){setErr(error.message);setPass('');setLoading(false);}
      }catch(e){setErr('Sign in failed. Please try again.');setPass('');setLoading(false);}
    }
  };
  return (
    <div className="relative min-h-screen bg-navy flex flex-col items-center justify-center p-5">
      {onBack&&<button onClick={onBack} className="absolute top-5 left-5 flex items-center gap-1 text-white/40 text-xs">
        <Icon name="back" size={14} color="rgba(255,255,255,0.4)"/> Back
      </button>}
      <img src="/icon-192.png" className="mb-4 shadow-2xl" alt="VanGuard" style={{width:'80px',height:'80px',borderRadius:'20px'}}/>
      <h1 className="text-3xl font-black text-white mb-1">Van<span style={{color:'#0D7377'}}>Guard</span></h1>
      <p className="text-white/40 text-sm mb-8 text-center">Stay compliant. Keep moving.</p>
      <div className="w-full max-w-sm bg-white rounded-2xl p-6 shadow-2xl">
        {mode==='forgot'?(
          <>
            <button onClick={()=>{setMode('login');setErr('');setOk('');}} className="flex items-center gap-1 text-xs text-gray-400 mb-4">
              <Icon name="back" size={14} color="#9CA3AF"/> Back to sign in
            </button>
            <h2 className="font-black text-navy text-lg mb-1">Reset password</h2>
            <p className="text-sm text-gray-400 mb-4">Enter your email and we'll send a reset link.</p>
            <ErrMsg msg={err}/>
            {ok?<OkMsg msg={ok}/>:<>
              <Input label="Email" value={email} onChange={setEmail} type="email" placeholder="you@example.com" required/>
              <Btn onClick={submit} loading={loading}>Send reset link</Btn>
            </>}
          </>
        ):(
          <>
            <div className="flex rounded-xl bg-gray-100 p-1 mb-5">
              {['login','register'].map(m=>(
                <button key={m} onClick={()=>{setMode(m);setErr('');}}
                  className={`flex-1 py-2 rounded-lg text-sm font-semibold transition-all ${mode===m?'bg-white shadow text-navy':'text-gray-400'}`}>
                  {m==='login'?'Sign In':'Free Trial'}
                </button>
              ))}
            </div>
            <ErrMsg msg={err}/>
            {ok&&<OkMsg msg={ok}/>}
            {mode==='register'&&<>
              <Input label="Your name" value={name} onChange={setName} placeholder="Sarah Jones" required/>
              <Input label="Business name" value={biz} onChange={setBiz} placeholder="The Taco Van" required/>
            </>}
            <Input label="Email" value={email} onChange={setEmail} type="email" placeholder="you@example.com" required/>
            <Input label="Password" value={pass} onChange={setPass} type="password" placeholder="Min. 6 characters" required/>
            {mode==='register'&&<p className="text-xs text-gray-400 text-center mb-4">14-day free trial · Card required to start · Cancel anytime</p>}
            <Btn onClick={submit} loading={loading}>{mode==='register'?'Start Free Trial':'Sign In'}</Btn>
            {mode==='login'&&<button onClick={()=>{setMode('forgot');setErr('');}} className="w-full text-center text-xs text-gray-400 mt-3 py-1">Forgot password?</button>}
          </>
        )}
      </div>
      <p className="text-white/25 text-xs mt-6 text-center">Food safety compliance built for mobile caterers · £7.99/month after trial</p>
    </div>
  );
};

// ── ONBOARDING WIZARD ─────────────────────────────────────────────────────────
const unitTypes=[
  {key:'van',label:'Food Van',emoji:'🚐',desc:'Motorised catering van'},
  {key:'trailer',label:'Trailer',emoji:'🚛',desc:'Towed catering trailer'},
  {key:'gazebo',label:'Gazebo / Stall',emoji:'⛺',desc:'Market stall or tent'},
  {key:'tricycle',label:'Bike / Trike',emoji:'🚲',desc:'Bicycle or tricycle unit'},
];
// Default daily checklists (shared by onboarding + the Daily Diary).
const DEFAULT_OPENING=['Fridge/freezer temps checked','Hand washing station set up','Unit cleaned from previous use','Food stored correctly (covered & separated)'];
const DEFAULT_CLOSING=['Food stored away or safely discarded','Equipment cleaned and put away','All power and gas turned off','Unit secured and locked'];
const DEFAULT_CLEANING=['Work surfaces wiped & sanitised','Chopping boards cleaned','Fridge/freezer wiped inside','Cooking equipment cleaned','Floors swept & mopped','Bins emptied & relined','Hand wash station restocked','Waste disposed correctly'];
// localStorage keys for a user's custom checklist lines (also mirrored to profiles.custom_checklists).
const ckKeys=uid=>({opening:`vg_coj_${uid}`,closing:`vg_cclosej_${uid}`,cleaning:`vg_ccj_${uid}`});
const rmKeys=uid=>({opening:`vg_rmopen_${uid}`,closing:`vg_rmclose_${uid}`,cleaning:`vg_rmclean_${uid}`});
const readCustom=(uid,which)=>{try{return JSON.parse(localStorage.getItem(ckKeys(uid)[which]))||[];}catch{return[];}};
const writeCustom=(uid,which,list)=>{try{localStorage.setItem(ckKeys(uid)[which],JSON.stringify(list));}catch{}};
const readRemoved=(uid,which)=>{try{return JSON.parse(localStorage.getItem(rmKeys(uid)[which]))||[];}catch{return[];}};
const writeRemoved=(uid,which,list)=>{try{localStorage.setItem(rmKeys(uid)[which],JSON.stringify(list));}catch{}};
// Hydrate localStorage from a saved profile so custom checklists follow the user across devices.
const hydrateChecklists=(uid,saved)=>{
  if(!saved||typeof saved!=='object') return;
  ['opening','closing','cleaning'].forEach(which=>{
    if(Array.isArray(saved[which])&&!localStorage.getItem(ckKeys(uid)[which])) writeCustom(uid,which,saved[which]);
    if(saved.removed&&Array.isArray(saved.removed[which])&&!localStorage.getItem(rmKeys(uid)[which])) writeRemoved(uid,which,saved.removed[which]);
  });
};
// One editable checklist inside the onboarding "customise" step.
const ChecklistEditor=({title,defaults,removed,setRemoved,custom,setCustom})=>{
  const [txt,setTxt]=useState('');
  const add=()=>{const v=txt.trim();if(!v)return;setCustom([...custom,{id:Date.now().toString(),label:v}]);setTxt('');};
  return (
    <div className="bg-white rounded-2xl p-4 mb-3">
      <p className="font-bold text-navy text-sm mb-2">{title}</p>
      {defaults.map((item,i)=>{
        const gone=removed.includes(i);
        return (
          <div key={i} className={`flex items-center gap-2 py-1.5 ${gone?'opacity-40':''}`}>
            <div className="w-4 h-4 rounded border-2 border-gray-200 flex-shrink-0"/>
            <span className={`text-sm flex-1 text-gray-700 ${gone?'line-through':''}`}>{item}</span>
            <button onClick={()=>setRemoved(gone?removed.filter(x=>x!==i):[...removed,i])}
              className="text-xs font-semibold flex-shrink-0" style={{color:gone?'#0D7377':'#EF4444'}}>
              {gone?'Add back':'Remove'}
            </button>
          </div>
        );
      })}
      {custom.map(job=>(
        <div key={job.id} className="flex items-center gap-2 py-1.5">
          <div className="w-4 h-4 rounded border-2 border-teal flex-shrink-0"/>
          <span className="text-sm flex-1 text-gray-700">{job.label}</span>
          <button onClick={()=>setCustom(custom.filter(j=>j.id!==job.id))} className="text-gray-300 hover:text-red-400 text-lg leading-none flex-shrink-0">×</button>
        </div>
      ))}
      <div className="flex gap-2 mt-2 pt-2 border-t border-gray-100">
        <input value={txt} onChange={e=>setTxt(e.target.value)} onKeyDown={e=>e.key==='Enter'&&add()} placeholder="Add your own line…"
          className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
        <button onClick={add} disabled={!txt.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
      </div>
    </div>
  );
};

const OnboardingWizard = ({userId,profile,onComplete}) => {
  const [step,setStep]=useState(1);
  const TOTAL=4;
  const [unitType,setUnitType]=useState(profile?.unit_type||'van');
  const [useLPG,setUseLPG]=useState(profile?.lpg_enabled!==false);
  const [authority,setAuthority]=useState(profile?.authority||'');
  const [hygieneRating,setHygieneRating]=useState(profile?.hygiene_rating??null); // null = not yet rated, 0-5
  // New profile questions
  const [teamSize,setTeamSize]=useState(profile?.team_size||'solo');
  const [waterOnboard,setWaterOnboard]=useState(profile?.water_enabled??false);
  const [foodType,setFoodType]=useState(profile?.food_type||'');
  // Checklist customisation (hydrated from any existing saved lists)
  const [rmOpen,setRmOpen]=useState(()=>readRemoved(userId,'opening'));
  const [rmClose,setRmClose]=useState(()=>readRemoved(userId,'closing'));
  const [rmClean,setRmClean]=useState(()=>readRemoved(userId,'cleaning'));
  const [cOpen,setCOpen]=useState(()=>readCustom(userId,'opening'));
  const [cClose,setCClose]=useState(()=>readCustom(userId,'closing'));
  const [cClean,setCClean]=useState(()=>readCustom(userId,'cleaning'));
  const [saving,setSaving]=useState(false);
  const finish=async()=>{
    setSaving(true);
    // Persist checklist choices to localStorage (used by the Daily Diary)…
    writeCustom(userId,'opening',cOpen);writeCustom(userId,'closing',cClose);writeCustom(userId,'cleaning',cClean);
    writeRemoved(userId,'opening',rmOpen);writeRemoved(userId,'closing',rmClose);writeRemoved(userId,'cleaning',rmClean);
    const custom_checklists={opening:cOpen,closing:cClose,cleaning:cClean,removed:{opening:rmOpen,closing:rmClose,cleaning:rmClean}};
    const fields={unit_type:unitType,authority,lpg_enabled:useLPG,hygiene_rating:hygieneRating,team_size:teamSize,water_enabled:waterOnboard,food_type:foodType,custom_checklists,onboarded:true};
    // Update (not upsert) so we only touch these columns and never clobber name/business_name.
    await sb.from('profiles').update(fields).eq('id',userId);
    localStorage.setItem('vg_ob_'+userId,'1');
    onComplete({...profile,...fields});
  };
  const Dots=()=>(
    <div className="flex gap-2 justify-center mb-8">
      {Array.from({length:TOTAL},(_,k)=>k+1).map(i=>(
        <div key={i} className={`rounded-full transition-all ${step===i?'w-8 h-2 bg-teal':'w-2 h-2 bg-white/20'}`}/>
      ))}
    </div>
  );
  const NavBtns=({onBack,onNext,nextLabel='Next →'})=>(
    <div className="flex gap-2">
      {onBack&&<button onClick={onBack} className="flex-1 py-3.5 rounded-xl font-semibold text-sm bg-white/10 text-white">← Back</button>}
      <button onClick={onNext} className="flex-1 py-3.5 rounded-xl font-semibold text-sm bg-teal text-white">{nextLabel}</button>
    </div>
  );
  return (
    <div className="min-h-screen bg-navy flex flex-col items-center justify-center p-5 py-10">
      <div className="w-full max-w-sm">
        <Dots/>
        {step===1&&(
          <div className="fade-in">
            <h2 className="text-2xl font-black text-white text-center mb-2">What's your unit type?</h2>
            <p className="text-white/50 text-sm text-center mb-6">This helps us tailor your daily checklists</p>
            <div className="grid grid-cols-2 gap-3 mb-6">
              {unitTypes.map(u=>(
                <button key={u.key} onClick={()=>setUnitType(u.key)}
                  className={`p-4 rounded-2xl border-2 text-left transition-all ${unitType===u.key?'bg-teal border-teal text-white':'bg-white/10 border-white/10 text-white'}`}>
                  <div className="text-2xl mb-1">{u.emoji}</div>
                  <div className="font-bold text-sm">{u.label}</div>
                  <div className={`text-xs ${unitType===u.key?'text-white/70':'text-white/40'}`}>{u.desc}</div>
                </button>
              ))}
            </div>
            <Btn onClick={()=>setStep(2)}>Next →</Btn>
          </div>
        )}
        {step===2&&(
          <div className="fade-in">
            <h2 className="text-2xl font-black text-white text-center mb-2">A bit more detail</h2>
            <p className="text-white/50 text-sm text-center mb-6">We'll customise your checks based on your answers</p>
            <div className="bg-white rounded-2xl p-5 mb-4">
              <p className="font-bold text-navy text-sm mb-3">Do you use LPG / bottled gas?</p>
              <div className="grid grid-cols-2 gap-2 mb-4">
                {[{v:true,l:'Yes — I use gas'},{v:false,l:'No gas appliances'}].map(o=>(
                  <button key={String(o.v)} onClick={()=>setUseLPG(o.v)}
                    className={`py-3 rounded-xl text-sm font-semibold border-2 transition-all ${useLPG===o.v?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                    {o.l}
                  </button>
                ))}
              </div>
              <p className="font-bold text-navy text-sm mb-3">Do you carry a water tank on board?</p>
              <div className="grid grid-cols-2 gap-2 mb-4">
                {[{v:true,l:'Yes'},{v:false,l:'No'}].map(o=>(
                  <button key={String(o.v)} onClick={()=>setWaterOnboard(o.v)}
                    className={`py-3 rounded-xl text-sm font-semibold border-2 transition-all ${waterOnboard===o.v?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                    {o.l}
                  </button>
                ))}
              </div>
              <p className="font-bold text-navy text-sm mb-3">Who runs the unit day to day?</p>
              <div className="grid grid-cols-2 gap-2 mb-4">
                {[{v:'solo',l:'Just me'},{v:'team',l:'Me + staff'}].map(o=>(
                  <button key={o.v} onClick={()=>setTeamSize(o.v)}
                    className={`py-3 rounded-xl text-sm font-semibold border-2 transition-all ${teamSize===o.v?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                    {o.l}
                  </button>
                ))}
              </div>
              <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">What do you mainly serve? <span className="font-normal text-gray-400 normal-case">(optional)</span></label>
              <input value={foodType} onChange={e=>setFoodType(e.target.value)} placeholder="e.g. Burgers, coffee, tacos"
                className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none focus:border-teal mb-4"/>
              <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Your local council / authority</label>
              <input value={authority} onChange={e=>setAuthority(e.target.value)} placeholder="e.g. Southwark Council"
                className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
              <p className="text-xs text-gray-400 mt-1">Your EHO inspecting authority</p>
              <div className="mt-4 pt-4 border-t border-gray-100">
                <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Current food hygiene rating <span className="font-normal text-gray-400 normal-case">(optional)</span></label>
                <div className="flex gap-1.5 mb-1">
                  {[1,2,3,4,5].map(v=>{
                    const active=hygieneRating===v;
                    const col=v>=4?'#16a34a':v===3?'#d97706':'#ef4444';
                    return(
                      <button key={v} onClick={()=>setHygieneRating(active?null:v)}
                        className="flex-1 py-2.5 rounded-xl text-sm font-bold border-2 transition-all"
                        style={{background:active?col:'#F9FAFB',borderColor:active?col:'#E5E7EB',color:active?'white':col}}>
                        {v}★
                      </button>
                    );
                  })}
                </div>
                <p className="text-xs text-gray-400">{hygieneRating!==null?`You've selected ${hygieneRating}/5 — we'll show this on your profile`:'Tap your current rating. Skip if not yet inspected.'}</p>
              </div>
            </div>
            <NavBtns onBack={()=>setStep(1)} onNext={()=>setStep(3)}/>
          </div>
        )}
        {step===3&&(
          <div className="fade-in">
            <h2 className="text-2xl font-black text-white text-center mb-2">Your daily checklists</h2>
            <p className="text-white/50 text-sm text-center mb-6">Here's what you'll tick off each day. Remove anything that doesn't apply, or add your own lines — you can change these anytime.</p>
            <ChecklistEditor title="Opening checks" defaults={DEFAULT_OPENING} removed={rmOpen} setRemoved={setRmOpen} custom={cOpen} setCustom={setCOpen}/>
            <ChecklistEditor title="Closing checks" defaults={DEFAULT_CLOSING} removed={rmClose} setRemoved={setRmClose} custom={cClose} setCustom={setCClose}/>
            <ChecklistEditor title="Cleaning schedule" defaults={DEFAULT_CLEANING} removed={rmClean} setRemoved={setRmClean} custom={cClean} setCustom={setCClean}/>
            <div className="mt-1"><NavBtns onBack={()=>setStep(2)} onNext={()=>setStep(4)}/></div>
          </div>
        )}
        {step===4&&(
          <div className="fade-in text-center">
            <div className="w-20 h-20 bg-teal rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-xl">
              <Icon name="check" size={40} color="white"/>
            </div>
            <h2 className="text-2xl font-black text-white mb-2">You're all set!</h2>
            <p className="text-white/50 text-sm mb-2">Your daily checklists are customised for your {unitTypes.find(u=>u.key===unitType)?.label||'unit'}.</p>
            {useLPG&&<p className="text-white/50 text-sm mb-1">LPG safety checks are included.</p>}
            {!useLPG&&<p className="text-white/50 text-sm mb-1">LPG section is hidden — you can enable it in Account anytime.</p>}
            <p className="text-white/50 text-sm mb-6">Next, start your 14-day free trial.</p>
            <Btn onClick={finish} loading={saving} size="lg">Continue</Btn>
          </div>
        )}
      </div>
    </div>
  );
};

// ── DASHBOARD ─────────────────────────────────────────────────────────────────
const Dashboard = ({profile,userId,onNav}) => {
  const [status,setStatus]=useState({diary:false,temps:0,clean:false,van:false});
  const [counts,setCounts]=useState({diaries:0,temps:0});
  const [loading,setLoading]=useState(true);
  const todayStr=today();
  useEffect(()=>{
    const load=async()=>{
      const [{count:dC},{count:tC},{data:tD},{data:tT},{data:tC2},{data:tV}]=await Promise.all([
        sb.from('diaries').select('*',{count:'exact',head:true}).eq('user_id',userId),
        sb.from('temp_logs').select('*',{count:'exact',head:true}).eq('user_id',userId),
        sb.from('diaries').select('opening,closing').eq('user_id',userId).eq('date',todayStr),
        sb.from('temp_logs').select('id').eq('user_id',userId).eq('date',todayStr),
        sb.from('cleaning_logs').select('id').eq('user_id',userId).eq('date',todayStr),
        sb.from('van_checks').select('id').eq('user_id',userId).eq('date',todayStr),
      ]);
      setCounts({diaries:dC||0,temps:tC||0});
      // Diary counts as done only when BOTH opening and closing are complete
      // (mirrors the Diary screen, honouring removed lines and NA items).
      let na={};try{na=JSON.parse(localStorage.getItem('vg_na_diary_'+userId))||{};}catch{}
      const rmO=readRemoved(userId,'opening'),rmC=readRemoved(userId,'closing');
      const d0=tD&&tD[0];
      const openDone=!!d0&&DEFAULT_OPENING.every((_,i)=>rmO.includes(i)||(d0.opening&&d0.opening[i])||na['o'+i]);
      const closeDone=!!d0&&DEFAULT_CLOSING.every((_,i)=>rmC.includes(i)||(d0.closing&&d0.closing[i])||na['c'+i]);
      setStatus({diary:openDone&&closeDone,diaryOpen:openDone,diaryClose:closeDone,temps:tT?.length||0,clean:!!(tC2?.length),van:!!(tV?.length)});
      setLoading(false);
    };
    load();
  },[userId]);
  const tasks=[
    {label:'Daily diary completed',done:status.diary,nav:'diary',hint:status.diary?'Opening & closing done':status.diaryOpen?'Closing checks still to do':'Opening checks to do'},
    {label:'Temperature checks',done:status.temps>=2,nav:'temp',hint:`${status.temps}/2 readings today`},
    {label:'Cleaning schedule',done:status.clean,nav:'diary',hint:'Sign off today\'s cleaning'},
    {label:'Van & safety check',done:status.van,nav:'van',hint:'Daily unit inspection'},
  ];
  const done=tasks.filter(t=>t.done).length;
  const pct=Math.round((done/4)*100);
  const ringCol=pct===100?'#16a34a':pct>=50?'#f59e0b':'#ef4444';
  const trialDays=profile?.trial_start?Math.floor((new Date()-new Date(profile.trial_start))/86400000):0;
  const trialLeft=Math.max(0,14-trialDays);
  const hour=new Date().getHours();
  const greeting=hour<12?'Good morning':hour<17?'Good afternoon':'Good evening';
  return (
    <div className="pt-28 pb-8 px-4">
      {/* Hero */}
      <div className="bg-navy rounded-2xl p-5 mb-4 flex items-center gap-4">
        {loading?(
          <div className="w-16 h-16 flex items-center justify-center"><div className="w-6 h-6 border-2 border-white/20 border-t-white rounded-full animate-spin"/></div>
        ):(
          <div className="relative w-16 h-16 flex-shrink-0">
            <svg viewBox="0 0 36 36" className="w-16 h-16 -rotate-90">
              <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(255,255,255,0.1)" strokeWidth="3"/>
              <circle cx="18" cy="18" r="15.9" fill="none" stroke={ringCol} strokeWidth="3"
                strokeDasharray={`${pct} ${100-pct}`} strokeLinecap="round"/>
            </svg>
            <div className="absolute inset-0 flex items-center justify-center">
              <span className="text-white font-black text-sm">{pct}%</span>
            </div>
          </div>
        )}
        <div className="flex-1 min-w-0">
          <p className="text-white/50 text-xs">{greeting},</p>
          <p className="text-white font-bold text-lg leading-tight">{profile?.name?.split(' ')[0]||'there'} 👋</p>
          <p className={`text-sm font-semibold mt-1 ${pct===100?'text-green-400':pct>0?'text-amber-400':'text-white/50'}`}>
            {pct===100?'✓ EHO ready for today':`${done} of 4 checks done`}
          </p>
        </div>
        {trialLeft>0&&<Badge label={`${trialLeft}d left`} color="amber"/>}
      </div>
      {/* Today's tasks */}
      <div className="mb-2"><p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mb-2">Today's Checks</p></div>
      <Card className="divide-y divide-gray-50 mb-5">
        {tasks.map((t,i)=>(
          <button key={i} onClick={()=>onNav(t.nav)}
            className="w-full flex items-center gap-3 px-4 py-3.5 active:bg-gray-50 text-left">
            <div className={`w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 ${t.done?'bg-green-100':'bg-gray-100'}`}>
              {t.done?<Icon name="check" size={15} color="#16a34a"/>:<div className="w-2 h-2 rounded-full bg-gray-300"/>}
            </div>
            <div className="flex-1 min-w-0">
              <p className={`text-sm font-semibold ${t.done?'line-through text-gray-300':'text-gray-800'}`}>{t.label}</p>
              <p className={`text-xs ${t.done?'text-gray-300':'text-gray-400'}`}>{t.hint}</p>
            </div>
            {!t.done&&<Icon name="chevron" size={16} color="#CBD5E1"/>}
          </button>
        ))}
      </Card>
      {/* Stats */}
      <div className="mb-2"><p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mb-2">Your Records</p></div>
      <div className="grid grid-cols-2 gap-3 mb-5">
        <Card className="p-4"><p className="text-2xl font-black text-teal">{counts.diaries}</p><p className="text-xs text-gray-400 mt-0.5">Diary entries</p></Card>
        <Card className="p-4"><p className="text-2xl font-black text-teal">{counts.temps}</p><p className="text-xs text-gray-400 mt-0.5">Temp readings</p></Card>
      </div>
      {/* Records shortcut */}
      <button onClick={()=>onNav('records')} className="w-full bg-navy rounded-2xl p-4 flex items-center gap-3 active:opacity-80">
        <div className="w-10 h-10 bg-teal rounded-xl flex items-center justify-center flex-shrink-0">
          <Icon name="eho" size={20} color="white"/>
        </div>
        <div className="flex-1 text-left">
          <p className="text-white font-bold text-sm">Compliance Records</p>
          <p className="text-white/40 text-xs">Browse history &amp; export EHO pack</p>
        </div>
        <Icon name="chevron" size={18} color="rgba(255,255,255,0.3)"/>
      </button>
    </div>
  );
};

// ── DIARY ─────────────────────────────────────────────────────────────────────
const DiaryScreen = ({userId,profile}) => {
  const todayStr=today();
  const [tab,setTab]=useState('opening');
  const [location,setLocation]=useState('');
  const [opening,setOpening]=useState({});
  const [closing,setClosing]=useState({});
  const [issues,setIssues]=useState('');
  const [cleanChecks,setCleanChecks]=useState({});
  const [cleanBy,setCleanBy]=useState(profile?.name||'');
  const [saving,setSaving]=useState(false);
  const [savedD,setSavedD]=useState(false);
  const [savedC,setSavedC]=useState(false);
  const [recent,setRecent]=useState([]);
  const [loading,setLoading]=useState(true);
  const [diaryNA,setDiaryNA]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_na_diary_${userId}`))||{};}catch{return{};}});
  const toggleDiaryNA=key=>{const u={...diaryNA,[key]:!diaryNA[key]};setDiaryNA(u);localStorage.setItem(`vg_na_diary_${userId}`,JSON.stringify(u));};
  const [customCleanJobs,setCustomCleanJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_ccj_${userId}`))||[];}catch{return[];}});
  const [newCleanJob,setNewCleanJob]=useState('');
  const addCleanJob=()=>{if(!newCleanJob.trim())return;const job={id:Date.now().toString(),label:newCleanJob.trim()};const u=[...customCleanJobs,job];setCustomCleanJobs(u);localStorage.setItem(`vg_ccj_${userId}`,JSON.stringify(u));setNewCleanJob('');};
  const removeCleanJob=id=>{const u=customCleanJobs.filter(j=>j.id!==id);setCustomCleanJobs(u);localStorage.setItem(`vg_ccj_${userId}`,JSON.stringify(u));const nc={...cleanChecks};delete nc[`ccj_${id}`];setCleanChecks(nc);};
  const [customOpenJobs,setCustomOpenJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_coj_${userId}`))||[];}catch{return[];}});
  const [newOpenJob,setNewOpenJob]=useState('');
  const addOpenJob=()=>{if(!newOpenJob.trim())return;const job={id:Date.now().toString(),label:newOpenJob.trim()};const u=[...customOpenJobs,job];setCustomOpenJobs(u);localStorage.setItem(`vg_coj_${userId}`,JSON.stringify(u));setNewOpenJob('');};
  const removeOpenJob=id=>{const u=customOpenJobs.filter(j=>j.id!==id);setCustomOpenJobs(u);localStorage.setItem(`vg_coj_${userId}`,JSON.stringify(u));const nc={...opening};delete nc[`coj_${id}`];setOpening(nc);};
  const [customCloseJobs,setCustomCloseJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_cclosej_${userId}`))||[];}catch{return[];}});
  const [newCloseJob,setNewCloseJob]=useState('');
  const addCloseJob=()=>{if(!newCloseJob.trim())return;const job={id:Date.now().toString(),label:newCloseJob.trim()};const u=[...customCloseJobs,job];setCustomCloseJobs(u);localStorage.setItem(`vg_cclosej_${userId}`,JSON.stringify(u));setNewCloseJob('');};
  const removeCloseJob=id=>{const u=customCloseJobs.filter(j=>j.id!==id);setCustomCloseJobs(u);localStorage.setItem(`vg_cclosej_${userId}`,JSON.stringify(u));const nc={...closing};delete nc[`closej_${id}`];setClosing(nc);};
  const openingItems=DEFAULT_OPENING;
  const closingItems=DEFAULT_CLOSING;
  const cleanItems=DEFAULT_CLEANING;
  // Default lines the user removed during onboarding (or later). Treated like "not applicable".
  const rmOpen=readRemoved(userId,'opening');
  const rmClose=readRemoved(userId,'closing');
  const rmClean=readRemoved(userId,'cleaning');
  useEffect(()=>{
    const load=async()=>{
      const [{data:all},{data:cl}]=await Promise.all([
        sb.from('diaries').select('*').eq('user_id',userId).order('date',{ascending:false}).limit(14),
        sb.from('cleaning_logs').select('*').eq('user_id',userId).eq('date',todayStr).maybeSingle(),
      ]);
      const td=(all||[]).find(d=>d.date===todayStr);
      if(td){setLocation(td.location||'');setOpening(td.opening||{});setClosing(td.closing||{});setIssues(td.issues||'');setSavedD(true);}
      if(cl){setCleanChecks(cl.checks||{});setCleanBy(cl.saved_by||profile?.name||'');setSavedC(true);}
      setRecent((all||[]).filter(d=>d.date!==todayStr).slice(0,7));
      setLoading(false);
    };
    load();
  },[userId]);
  const saveDiary=async()=>{
    setSaving(true);
    await sb.from('diaries').upsert({user_id:userId,date:todayStr,location,opening,closing,issues},{onConflict:'user_id,date'});
    setSavedD(true); setSaving(false);
  };
  const saveClean=async()=>{
    setSaving(true);
    await sb.from('cleaning_logs').upsert({user_id:userId,date:todayStr,checks:cleanChecks,saved_by:cleanBy},{onConflict:'user_id,date'});
    setSavedC(true); setSaving(false);
  };
  const saveEndOfDay=async()=>{
    setSaving(true);
    await Promise.all([
      sb.from('diaries').upsert({user_id:userId,date:todayStr,location,opening,closing,issues},{onConflict:'user_id,date'}),
      sb.from('cleaning_logs').upsert({user_id:userId,date:todayStr,checks:cleanChecks,saved_by:cleanBy},{onConflict:'user_id,date'}),
    ]);
    setSavedD(true);setSavedC(true);setSaving(false);
  };
  if(loading) return <div className="pt-28"><Spinner full/></div>;
  const allOpen=openingItems.every((_,i)=>rmOpen.includes(i)||opening[i]||diaryNA['o'+i]);
  const allClose=closingItems.every((_,i)=>rmClose.includes(i)||closing[i]||diaryNA['c'+i]);
  const allClean=cleanItems.every((_,i)=>rmClean.includes(i)||cleanChecks[i]||diaryNA['cl'+i]);
  const tickAllOpen=()=>{const o={...opening};openingItems.forEach((_,i)=>{if(!rmOpen.includes(i))o[i]=true;});customOpenJobs.forEach(j=>{o[`coj_${j.id}`]=true;});setOpening(o);};
  const tickAllClose=()=>{const c={...closing};closingItems.forEach((_,i)=>{if(!rmClose.includes(i))c[i]=true;});customCloseJobs.forEach(j=>{c[`closej_${j.id}`]=true;});setClosing(c);};
  const tickAllClean=()=>{const c={...cleanChecks};cleanItems.forEach((_,i)=>{if(!rmClean.includes(i))c[i]=true;});customCleanJobs.forEach(j=>{c[`ccj_${j.id}`]=true;});setCleanChecks(c);};
  const TickAll=({onClick})=>(<button onClick={onClick} className="text-xs font-bold text-teal active:opacity-60">Tick all</button>);
  return (
    <div className="pt-28 pb-8 px-4">
      <Card className="p-4 mb-4">
        <div className="flex items-center gap-2 mb-3">
          <Icon name="location" size={14} color="#0D7377"/>
          <span className="text-xs font-bold text-teal uppercase tracking-wide">{fmtDate(todayStr)}</span>
          {savedD&&<Badge label="Saved" color="green"/>}
        </div>
        <Input label="Where are you trading today?" value={location} onChange={setLocation} placeholder="e.g. Borough Market, Stall 12"/>
      </Card>
      {/* Tab selector */}
      <div className="flex rounded-xl bg-gray-100 p-1 mb-4">
        {[{k:'opening',l:'Opening'},{k:'closing',l:'End of Day'}].map(t=>(
          <button key={t.k} onClick={()=>setTab(t.k)}
            className={`flex-1 py-2.5 rounded-lg text-xs font-bold transition-all ${tab===t.k?'bg-white shadow text-navy':'text-gray-400'}`}>
            {t.l}
          </button>
        ))}
      </div>
      {tab==='opening'&&(
        <Card className="p-4 fade-in">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-navy text-sm">Opening Checks</h3>
            <div className="flex items-center gap-2">{allOpen?<Badge label="All done" color="green"/>:<TickAll onClick={tickAllOpen}/>}</div>
          </div>
          {openingItems.map((item,i)=>rmOpen.includes(i)?null:(
            <Checkbox key={i} checked={!!opening[i]} onChange={v=>setOpening(p=>({...p,[i]:v}))} label={item} isNA={!!diaryNA['o'+i]} onToggleNA={()=>toggleDiaryNA('o'+i)}/>
          ))}
          {customOpenJobs.map(job=>(
            <div key={job.id} className="flex items-center gap-1">
              <div className="flex-1"><Checkbox checked={!!opening[`coj_${job.id}`]} onChange={v=>setOpening(p=>({...p,[`coj_${job.id}`]:v}))} label={job.label} isNA={!!diaryNA[`coj_${job.id}`]} onToggleNA={()=>toggleDiaryNA(`coj_${job.id}`)}/></div>
              <button onClick={()=>removeOpenJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
            </div>
          ))}
          <div className="flex gap-2 mt-3 pt-3 border-t border-gray-100">
            <input value={newOpenJob} onChange={e=>setNewOpenJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addOpenJob()} placeholder="Add custom item…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
            <button onClick={addOpenJob} disabled={!newOpenJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
          </div>
          <div className="mt-4"><Btn onClick={saveDiary} loading={saving} variant={savedD?'ghost':'primary'}>{savedD?'Apply changes':'Save opening checks'}</Btn></div>
        </Card>
      )}
      {tab==='closing'&&(
        <Card className="p-4 fade-in">
          {/* ── Closing Checks ── */}
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-navy text-sm">Closing Checks</h3>
            <div className="flex items-center gap-2">{allClose?<Badge label="Done" color="green"/>:<TickAll onClick={tickAllClose}/>}</div>
          </div>
          {closingItems.map((item,i)=>rmClose.includes(i)?null:(
            <Checkbox key={i} checked={!!closing[i]} onChange={v=>setClosing(p=>({...p,[i]:v}))} label={item} isNA={!!diaryNA['c'+i]} onToggleNA={()=>toggleDiaryNA('c'+i)}/>
          ))}
          {customCloseJobs.map(job=>(
            <div key={job.id} className="flex items-center gap-1">
              <div className="flex-1"><Checkbox checked={!!closing[`closej_${job.id}`]} onChange={v=>setClosing(p=>({...p,[`closej_${job.id}`]:v}))} label={job.label} isNA={!!diaryNA[`closej_${job.id}`]} onToggleNA={()=>toggleDiaryNA(`closej_${job.id}`)}/></div>
              <button onClick={()=>removeCloseJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
            </div>
          ))}
          <div className="flex gap-2 mt-3 pt-3 border-t border-gray-100">
            <input value={newCloseJob} onChange={e=>setNewCloseJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addCloseJob()} placeholder="Add custom check…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
            <button onClick={addCloseJob} disabled={!newCloseJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
          </div>
          {/* ── Cleaning Schedule ── */}
          <div className="flex items-center justify-between mt-6 mb-4 pt-5 border-t-2 border-gray-100">
            <h3 className="font-bold text-navy text-sm">Cleaning Schedule</h3>
            <div className="flex items-center gap-2">{allClean?<Badge label="Done" color="green"/>:<TickAll onClick={tickAllClean}/>}</div>
          </div>
          {cleanItems.map((item,i)=>rmClean.includes(i)?null:(
            <Checkbox key={i} checked={!!cleanChecks[i]} onChange={v=>setCleanChecks(p=>({...p,[i]:v}))} label={item} isNA={!!diaryNA['cl'+i]} onToggleNA={()=>toggleDiaryNA('cl'+i)}/>
          ))}
          {customCleanJobs.map(job=>(
            <div key={job.id} className="flex items-center gap-1">
              <div className="flex-1"><Checkbox checked={!!cleanChecks[`ccj_${job.id}`]} onChange={v=>setCleanChecks(p=>({...p,[`ccj_${job.id}`]:v}))} label={job.label} isNA={!!diaryNA[`ccj_${job.id}`]} onToggleNA={()=>toggleDiaryNA(`ccj_${job.id}`)}/></div>
              <button onClick={()=>removeCleanJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
            </div>
          ))}
          <div className="flex gap-2 mt-3 pt-3 border-t border-gray-100">
            <input value={newCleanJob} onChange={e=>setNewCleanJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addCleanJob()} placeholder="Add custom item…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
            <button onClick={addCleanJob} disabled={!newCleanJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
          </div>
          {/* ── Notes + sign-off ── */}
          <div className="mt-5 pt-5 border-t border-gray-100">
            <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Issues / notes (optional)</label>
            <textarea value={issues} onChange={e=>setIssues(e.target.value)} rows={3} placeholder="Any issues, incidents or actions taken today?"
              className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none focus:border-teal resize-none"/>
          </div>
          <div className="mt-3"><Input label="Signed off by" value={cleanBy} onChange={setCleanBy} placeholder="Your name"/></div>
          <Btn onClick={saveEndOfDay} loading={saving} variant={(savedD&&savedC)?'ghost':'primary'}>{(savedD&&savedC)?'Apply changes':'Save end of day'}</Btn>
        </Card>
      )}
      {recent.length>0&&(
        <div className="mt-6">
          <p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mb-3">Recent Entries</p>
          {recent.map((d,i)=>(
            <Card key={i} className="p-3.5 mb-2 flex items-center gap-3">
              <div className="w-8 h-8 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <Icon name="check" size={14} color="#16a34a"/>
              </div>
              <div className="flex-1">
                <p className="text-sm font-bold text-navy">{fmtDate(d.date)}</p>
                <p className="text-xs text-gray-400 truncate">{d.location||'No location recorded'}</p>
              </div>
              <span className="text-xs text-gray-300">{fmtDateShort(d.date)}</span>
            </Card>
          ))}
        </div>
      )}
    </div>
  );
};

// ── TEMPERATURE LOG ───────────────────────────────────────────────────────────
const DEFAULT_APPLIANCES=[
  {id:'a1',name:'Fridge 1',type:'cold',th:8,emoji:'🧊'},
  {id:'a2',name:'Freezer',type:'cold',th:-18,emoji:'❄️'},
  {id:'a3',name:'Hot Hold',type:'hot',th:63,emoji:'🔥'},
];
const applKey=uid=>`vg_appliances_${uid}`;
const loadAppliances=uid=>{try{return JSON.parse(localStorage.getItem(applKey(uid)))||DEFAULT_APPLIANCES;}catch{return DEFAULT_APPLIANCES;}};
const saveAppliances=(uid,list)=>localStorage.setItem(applKey(uid),JSON.stringify(list));

const TempScreen = ({userId}) => {
  const [appliances,setAppliances]=useState(()=>loadAppliances(userId));
  const [temps,setTemps]=useState({});
  const [actions,setActions]=useState({});
  const [allTemps,setAllTemps]=useState([]);
  const [saving,setSaving]=useState({});
  const [flash,setFlash]=useState({});
  const [editMode,setEditMode]=useState(false);
  const [showAdd,setShowAdd]=useState(false);
  const [newName,setNewName]=useState('');
  const [newType,setNewType]=useState('cold');
  const [newTh,setNewTh]=useState('');
  const [loading,setLoading]=useState(true);
  const todayStr=today();
  const loadTemps=async()=>{const{data}=await sb.from('temp_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(60);setAllTemps(data||[]);setLoading(false);};
  const deleteTemp=async(id)=>{const tok=_getS()?.access_token;await fetch(`${SUPA_URL}/rest/v1/temp_logs?id=eq.${id}`,{method:'DELETE',headers:_h(tok)});await loadTemps();};
  useEffect(()=>{loadTemps();},[userId]);
  const todayTemps=allTemps.filter(t=>t.date===todayStr);

  const logTemp=async(appl)=>{
    const tempVal=temps[appl.id]; if(!tempVal) return;
    const tempNum=parseFloat(tempVal);
    const isPass=appl.type==='hot'?tempNum>=appl.th:tempNum<=appl.th;
    setSaving(p=>({...p,[appl.id]:true}));
    await sb.from('temp_logs').insert({user_id:userId,date:todayStr,time:nowTime(),unit:appl.name,temp:tempNum,type:appl.type,threshold:appl.th,pass:isPass,action:actions[appl.id]||null});
    await loadTemps();
    setTemps(p=>({...p,[appl.id]:''})); setActions(p=>({...p,[appl.id]:''}));
    setFlash(p=>({...p,[appl.id]:true})); setTimeout(()=>setFlash(p=>({...p,[appl.id]:false})),2000);
    setSaving(p=>({...p,[appl.id]:false}));
  };
  const removeAppliance=id=>{const u=appliances.filter(a=>a.id!==id);setAppliances(u);saveAppliances(userId,u);};
  const addAppliance=()=>{
    if(!newName) return;
    const th=newTh?parseFloat(newTh):(newType==='cold'?8:63);
    const emoji=newType==='cold'?'🧊':'🔥';
    const u=[...appliances,{id:Date.now().toString(),name:newName,type:newType,th,emoji}];
    setAppliances(u); saveAppliances(userId,u);
    setNewName(''); setNewTh(''); setShowAdd(false);
  };

  if(loading) return <div className="pt-28"><Spinner full/></div>;
  return (
    <div className="pt-28 pb-8 px-4">
      {/* Status banner */}
      <div className={`rounded-2xl p-4 mb-4 flex items-center gap-3 border ${todayTemps.length>=2?'bg-green-50 border-green-100':'bg-amber-50 border-amber-100'}`}>
        <div className={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${todayTemps.length>=2?'bg-green-100':'bg-amber-100'}`}>
          <span className={`text-lg font-black ${todayTemps.length>=2?'text-green-700':'text-amber-700'}`}>{todayTemps.length}</span>
        </div>
        <div className="flex-1">
          <p className={`font-bold text-sm ${todayTemps.length>=2?'text-green-700':'text-amber-800'}`}>
            {todayTemps.length>=2?'Daily requirement met ✓':`${todayTemps.length} of 2 readings done today`}
          </p>
          <p className={`text-xs ${todayTemps.length>=2?'text-green-500':'text-amber-600'}`}>Need at least 2 readings per day</p>
        </div>
      </div>

      {/* Appliance header + manage button */}
      <div className="flex items-center justify-between mb-3">
        <p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1">Log Temperatures</p>
        <button onClick={()=>{setEditMode(p=>!p);setShowAdd(false);setNewName('');setNewTh('');}}
          className={`flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold transition-all ${editMode?'bg-navy text-white':'bg-teal text-white'}`}>
          {editMode?(
            <><span className="text-base leading-none">✓</span> Done</>
          ):(
            <><Icon name="plus" size={14} color="white"/> Add / Remove</>
          )}
        </button>
      </div>

      {appliances.map(appl=>{
        const tempVal=temps[appl.id]||'';
        const tempNum=parseFloat(tempVal);
        const isPass=tempVal?(appl.type==='hot'?tempNum>=appl.th:tempNum<=appl.th):null;
        const flashed=flash[appl.id];
        return (
          <Card key={appl.id} className="p-4 mb-3">
            <div className="flex items-center gap-2 mb-3">
              <span className="text-xl">{appl.emoji}</span>
              <div className="flex-1">
                <p className="font-bold text-navy text-sm">{appl.name}</p>
                <p className="text-xs text-gray-400">{appl.type==='hot'?`Must be ≥${appl.th}°C`:`Must be ≤${appl.th}°C`}</p>
              </div>
              {isPass!==null&&(
                <span className={`text-xs font-bold px-2 py-1 rounded-lg ${isPass?'bg-green-100 text-green-700':'bg-red-100 text-red-600'}`}>{isPass?'PASS':'FAIL'}</span>
              )}
              {editMode&&(
                <button onClick={()=>removeAppliance(appl.id)} className="w-7 h-7 bg-red-100 rounded-lg flex items-center justify-center ml-1">
                  <span className="text-red-500 font-black text-base leading-none">−</span>
                </button>
              )}
            </div>
            {flashed?<OkMsg msg="✓ Reading saved!"/>:(
              <>
                <div className="flex gap-2">
                  <div className="relative flex-1">
                    <input type="number" value={tempVal} onChange={e=>setTemps(p=>({...p,[appl.id]:e.target.value}))} placeholder="0"
                      className="w-full border border-gray-200 rounded-xl px-4 py-3 text-2xl font-black bg-gray-50 focus:outline-none focus:border-teal pr-10"/>
                    <span className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 font-bold text-sm">°C</span>
                  </div>
                  <button onClick={()=>logTemp(appl)} disabled={!tempVal||saving[appl.id]}
                    className={`px-6 rounded-xl font-bold text-sm transition-all flex items-center gap-1 ${tempVal?'bg-teal text-white':'bg-gray-100 text-gray-400'}`}>
                    {saving[appl.id]?<div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"/>:'Log'}
                  </button>
                </div>
                {tempVal&&!isPass&&(
                  <div className="mt-2">
                    <textarea value={actions[appl.id]||''} onChange={e=>setActions(p=>({...p,[appl.id]:e.target.value}))} rows={2}
                      placeholder="FAIL — note corrective action taken..."
                      className="w-full border border-red-200 rounded-xl px-4 py-2 text-sm bg-red-50 focus:outline-none resize-none mt-1"/>
                  </div>
                )}
              </>
            )}
          </Card>
        );
      })}

      {/* Inline add form — shown in edit mode */}
      {editMode&&(
        <Card className="p-4 mb-3 border-2 border-teal/30 fade-in">
          <p className="text-xs font-bold text-teal uppercase tracking-wide mb-3">Add New Appliance</p>
          <div className="grid grid-cols-3 gap-2 mb-3">
            {[{label:'Fridge',type:'cold',th:8,emoji:'🧊'},{label:'Freezer',type:'cold',th:-18,emoji:'❄️'},{label:'Hot Hold',type:'hot',th:63,emoji:'🔥'}].map(p=>(
              <button key={p.label} onClick={()=>{setNewName(p.label);setNewType(p.type);setNewTh(String(p.th));}}
                className={`py-2.5 rounded-xl border-2 text-xs font-semibold text-center transition-all ${newName===p.label?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                <div className="text-lg">{p.emoji}</div><div>{p.label}</div>
              </button>
            ))}
          </div>
          <Input label="Name" value={newName} onChange={setNewName} placeholder="e.g. Fridge 2, Prep Fridge"/>
          <div className="grid grid-cols-2 gap-3 mb-3">
            <div>
              <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Type</label>
              <div className="flex gap-2">
                {[{v:'cold',l:'Cold'},{v:'hot',l:'Hot'}].map(o=>(
                  <button key={o.v} onClick={()=>setNewType(o.v)}
                    className={`flex-1 py-2.5 rounded-xl text-sm font-semibold border-2 transition-all ${newType===o.v?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>{o.l}</button>
                ))}
              </div>
            </div>
            <Input label="Safe limit (°C)" value={newTh} onChange={setNewTh} type="number" placeholder={newType==='cold'?'8':'63'}/>
          </div>
          <Btn onClick={addAppliance} disabled={!newName} size="sm">+ Add appliance</Btn>
        </Card>
      )}

      {/* Today's readings */}
      {todayTemps.length>0&&(
        <>
          <p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mb-3">Today's Readings</p>
          {todayTemps.map((t,i)=>(
            <Card key={i} className="p-3.5 mb-2 flex items-center gap-3">
              <div className={`w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 ${t.pass?'bg-green-100':'bg-red-100'}`}>
                <Icon name={t.pass?'check':'warn'} size={14} color={t.pass?'#16a34a':'#dc2626'}/>
              </div>
              <div className="flex-1">
                <p className="text-sm font-bold text-navy">{t.unit}</p>
                <p className="text-xs text-gray-400">{t.time} · {t.temp}°C</p>
              </div>
              <span className={`text-xs font-bold px-2 py-1 rounded-lg ${t.pass?'bg-green-100 text-green-700':'bg-red-100 text-red-600'}`}>{t.pass?'PASS':'FAIL'}</span>
              <button onClick={()=>{if(window.confirm('Delete this reading?'))deleteTemp(t.id);}} className="w-7 h-7 rounded-lg bg-gray-100 flex items-center justify-center active:bg-red-100 flex-shrink-0 ml-1" title="Delete reading">
                <span className="text-gray-400 text-sm font-bold leading-none">×</span>
              </button>
            </Card>
          ))}
        </>
      )}
      {allTemps.filter(t=>t.date!==todayStr).length>0&&(
        <>
          <p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mt-5 mb-3">Previous</p>
          {allTemps.filter(t=>t.date!==todayStr).slice(0,10).map((t,i)=>(
            <Card key={i} className="p-3 mb-2 flex items-center gap-3">
              <div className={`w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0 ${t.pass?'bg-green-100':'bg-red-100'}`}>
                <Icon name={t.pass?'check':'warn'} size={12} color={t.pass?'#16a34a':'#dc2626'}/>
              </div>
              <div className="flex-1 min-w-0">
                <p className="text-xs font-semibold text-navy">{t.unit} · {t.temp}°C · {t.time}</p>
                <p className="text-xs text-gray-400">{fmtDate(t.date)}</p>
              </div>
              <span className={`text-xs font-bold ${t.pass?'text-green-600':'text-red-500'}`}>{t.pass?'PASS':'FAIL'}</span>
            </Card>
          ))}
        </>
      )}
    </div>
  );
};

// ── VAN & SAFETY ──────────────────────────────────────────────────────────────
const VanScreen = ({userId,profile}) => {
  const [tab,setTab]=useState('vehicle');
  const showLPG=profile?.lpg_enabled!==false;
  const showWater=profile?.water_enabled===true;
  const todayStr=today();
  const [saving,setSaving]=useState(false);
  const [vChecks,setVChecks]=useState({});
  const [vBy,setVBy]=useState(profile?.name||'');
  const [vSaved,setVSaved]=useState(false);
  const [lpgRecs,setLpgRecs]=useState([]);
  const [lpg,setLpg]=useState({hose:false,reg:false,flame:false,leak:false});
  const [lpgNotes,setLpgNotes]=useState('');
  const [lpgFlash,setLpgFlash]=useState(false);
  const [waterRecs,setWaterRecs]=useState([]);
  const [water,setWater]=useState({filled:false,cleaned:false,san:false});
  const [waterFlash,setWaterFlash]=useState(false);
  const [pitches,setPitches]=useState([]);
  const [pitchName,setPitchName]=useState('');
  const [pitchAddr,setPitchAddr]=useState('');
  const [pitchFlash,setPitchFlash]=useState(false);
  const [loading,setLoading]=useState(true);
  const [vanNA,setVanNA]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_na_van_${userId}`))||{};}catch{return{};}});
  const toggleVanNA=key=>{const u={...vanNA,[key]:!vanNA[key]};setVanNA(u);localStorage.setItem(`vg_na_van_${userId}`,JSON.stringify(u));};
  const [customVanJobs,setCustomVanJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_cvj_${userId}`))||[];}catch{return[];}});
  const [newVanJob,setNewVanJob]=useState('');
  const addVanJob=()=>{if(!newVanJob.trim())return;const job={id:Date.now().toString(),label:newVanJob.trim()};const u=[...customVanJobs,job];setCustomVanJobs(u);localStorage.setItem(`vg_cvj_${userId}`,JSON.stringify(u));setNewVanJob('');};
  const removeVanJob=id=>{const u=customVanJobs.filter(j=>j.id!==id);setCustomVanJobs(u);localStorage.setItem(`vg_cvj_${userId}`,JSON.stringify(u));const nc={...vChecks};delete nc[`cvj_${id}`];setVChecks(nc);};
  const [customLpgJobs,setCustomLpgJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_clpgj_${userId}`))||[];}catch{return[];}});
  const [customLpgChecks,setCustomLpgChecks]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_clpgchecks_${userId}`))||{};}catch{return{};}});
  const [newLpgJob,setNewLpgJob]=useState('');
  const addLpgJob=()=>{if(!newLpgJob.trim())return;const job={id:Date.now().toString(),label:newLpgJob.trim()};const u=[...customLpgJobs,job];setCustomLpgJobs(u);localStorage.setItem(`vg_clpgj_${userId}`,JSON.stringify(u));setNewLpgJob('');};
  const removeLpgJob=id=>{const u=customLpgJobs.filter(j=>j.id!==id);setCustomLpgJobs(u);localStorage.setItem(`vg_clpgj_${userId}`,JSON.stringify(u));const nc={...customLpgChecks};delete nc[id];setCustomLpgChecks(nc);localStorage.setItem(`vg_clpgchecks_${userId}`,JSON.stringify(nc));};
  const toggleLpgCheck=(id,v)=>{const nc={...customLpgChecks,[id]:v};setCustomLpgChecks(nc);localStorage.setItem(`vg_clpgchecks_${userId}`,JSON.stringify(nc));};
  const [customWaterJobs,setCustomWaterJobs]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_cwj_${userId}`))||[];}catch{return[];}});
  const [customWaterChecks,setCustomWaterChecks]=useState(()=>{try{return JSON.parse(localStorage.getItem(`vg_cwchecks_${userId}`))||{};}catch{return{};}});
  const [newWaterJob,setNewWaterJob]=useState('');
  const addWaterJob=()=>{if(!newWaterJob.trim())return;const job={id:Date.now().toString(),label:newWaterJob.trim()};const u=[...customWaterJobs,job];setCustomWaterJobs(u);localStorage.setItem(`vg_cwj_${userId}`,JSON.stringify(u));setNewWaterJob('');};
  const removeWaterJob=id=>{const u=customWaterJobs.filter(j=>j.id!==id);setCustomWaterJobs(u);localStorage.setItem(`vg_cwj_${userId}`,JSON.stringify(u));const nc={...customWaterChecks};delete nc[id];setCustomWaterChecks(nc);localStorage.setItem(`vg_cwchecks_${userId}`,JSON.stringify(nc));};
  const toggleWaterCheck=(id,v)=>{const nc={...customWaterChecks,[id]:v};setCustomWaterChecks(nc);localStorage.setItem(`vg_cwchecks_${userId}`,JSON.stringify(nc));};
  const vehicleItems=['Unit is clean and ready for service',showLPG?'Gas connections checked — no leaks':'Electrical connections checked','Fire extinguisher present and accessible','First aid kit stocked and accessible','Hand washing station set up and stocked','Food at correct temperatures','All equipment safely stored','Waste disposal set up'];
  useEffect(()=>{
    const load=async()=>{
      const [{data:vc},{data:lR},{data:wR},{data:pR}]=await Promise.all([
        sb.from('van_checks').select('*').eq('user_id',userId).eq('date',todayStr).maybeSingle(),
        sb.from('lpg_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(5),
        sb.from('water_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(3),
        sb.from('pitch_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(20),
      ]);
      if(vc){setVChecks(vc.checks||{});setVBy(vc.signed_by||profile?.name||'');setVSaved(true);}
      setLpgRecs(lR||[]); setWaterRecs(wR||[]); setPitches(pR||[]);
      setLoading(false);
    };
    load();
  },[userId]);
  const saveVehicle=async()=>{setSaving(true);await sb.from('van_checks').upsert({user_id:userId,date:todayStr,checks:vChecks,signed_by:vBy},{onConflict:'user_id,date'});setVSaved(true);setSaving(false);};
  const saveLPG=async()=>{
    if(!Object.values(lpg).every(Boolean)) return;
    setSaving(true);
    await sb.from('lpg_logs').insert({user_id:userId,date:todayStr,...lpg,notes:lpgNotes});
    const{data}=await sb.from('lpg_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(5);
    setLpgRecs(data||[]); setLpgFlash(true); setTimeout(()=>setLpgFlash(false),2000); setSaving(false);
  };
  const saveWater=async()=>{
    setSaving(true);
    await sb.from('water_logs').insert({user_id:userId,date:todayStr,...water});
    const{data}=await sb.from('water_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(3);
    setWaterRecs(data||[]); setWaterFlash(true); setTimeout(()=>setWaterFlash(false),2000); setSaving(false);
  };
  const savePitch=async()=>{
    if(!pitchName) return;
    setSaving(true);
    await sb.from('pitch_logs').insert({user_id:userId,date:todayStr,name:pitchName,address:pitchAddr});
    const{data}=await sb.from('pitch_logs').select('*').eq('user_id',userId).order('created_at',{ascending:false}).limit(20);
    setPitches(data||[]); setPitchFlash(true); setTimeout(()=>setPitchFlash(false),2000); setPitchName(''); setPitchAddr(''); setSaving(false);
  };
  const lastLPG=lpgRecs[0];
  const lpgDays=lastLPG?Math.floor((new Date()-new Date(lastLPG.created_at))/86400000):null;
  const lpgDue=!lastLPG||lpgDays>30;
  const tabs=[{k:'vehicle',l:'Unit'},{k:'lpg',l:'LPG'},{k:'water',l:'Water'},{k:'pitch',l:'Pitch'}].filter(t=>(t.k!=='lpg'||showLPG)&&(t.k!=='water'||showWater));
  if(loading) return <div className="pt-28"><Spinner full/></div>;
  return (
    <div className="pt-28 pb-8 px-4">
      <div className={`flex rounded-xl bg-gray-100 p-1 mb-4`}>
        {tabs.map(t=>(
          <button key={t.k} onClick={()=>setTab(t.k)}
            className={`flex-1 py-2.5 rounded-lg text-xs font-bold transition-all ${tab===t.k?'bg-white shadow text-navy':'text-gray-400'}`}>
            {t.l}
          </button>
        ))}
      </div>
      {tab==='vehicle'&&(
        <Card className="p-4 fade-in">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-navy text-sm">Daily Unit Check</h3>
            <button onClick={()=>{const c={...vChecks};vehicleItems.forEach((_,i)=>{c[i]=true;});customVanJobs.forEach(j=>{c[`cvj_${j.id}`]=true;});setVChecks(c);}} className="text-xs font-bold text-teal active:opacity-60">Tick all</button>
          </div>
          {vehicleItems.map((item,i)=>(
            <Checkbox key={i} checked={!!vChecks[i]} onChange={v=>setVChecks(p=>({...p,[i]:v}))} label={item} isNA={!!vanNA['v'+i]} onToggleNA={()=>toggleVanNA('v'+i)}/>
          ))}
          {customVanJobs.map(job=>(
            <div key={job.id} className="flex items-center gap-1">
              <div className="flex-1"><Checkbox checked={!!vChecks[`cvj_${job.id}`]} onChange={v=>setVChecks(p=>({...p,[`cvj_${job.id}`]:v}))} label={job.label} isNA={!!vanNA[`cvj_${job.id}`]} onToggleNA={()=>toggleVanNA(`cvj_${job.id}`)}/></div>
              <button onClick={()=>removeVanJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
            </div>
          ))}
          <div className="flex gap-2 mt-3 pt-3 border-t border-gray-100">
            <input value={newVanJob} onChange={e=>setNewVanJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addVanJob()} placeholder="Add custom check…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
            <button onClick={addVanJob} disabled={!newVanJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
          </div>
          <div className="mt-4"><Input label="Checked by" value={vBy} onChange={setVBy} placeholder="Your name"/></div>
          <Btn onClick={saveVehicle} loading={saving} variant={vSaved?'ghost':'primary'}>{vSaved?'Apply changes':'Save unit check'}</Btn>
        </Card>
      )}
      {tab==='lpg'&&showLPG&&(
        <div className="fade-in">
          <div className={`rounded-2xl p-4 mb-4 flex items-start gap-3 border ${lpgDue?'bg-amber-50 border-amber-200':'bg-green-50 border-green-100'}`}>
            <Icon name={lpgDue?'warn':'check'} size={18} color={lpgDue?'#d97706':'#16a34a'}/>
            <div>
              <p className={`font-bold text-sm ${lpgDue?'text-amber-800':'text-green-700'}`}>
                {!lastLPG?'No LPG check on record':lpgDue?`Overdue — last checked ${lpgDays} days ago`:`Checked ${lpgDays}d ago — next in ${30-lpgDays}d`}
              </p>
              <p className="text-xs text-gray-500 mt-0.5">Monthly LPG checks are required</p>
            </div>
          </div>
          <Card className="p-4 mb-3">
            <h3 className="font-bold text-navy text-sm mb-4">LPG Safety Inspection</h3>
            <Checkbox checked={lpg.hose} onChange={v=>setLpg(p=>({...p,hose:v}))} label="Gas hose in good condition — no cracks or damage" isNA={!!vanNA['lpg_hose']} onToggleNA={()=>toggleVanNA('lpg_hose')}/>
            <Checkbox checked={lpg.reg} onChange={v=>setLpg(p=>({...p,reg:v}))} label="Regulator secure and undamaged" isNA={!!vanNA['lpg_reg']} onToggleNA={()=>toggleVanNA('lpg_reg')}/>
            <Checkbox checked={lpg.flame} onChange={v=>setLpg(p=>({...p,flame:v}))} label="Flame supervision devices working correctly" isNA={!!vanNA['lpg_flame']} onToggleNA={()=>toggleVanNA('lpg_flame')}/>
            <Checkbox checked={lpg.leak} onChange={v=>setLpg(p=>({...p,leak:v}))} label="No gas smell or leaks detected" isNA={!!vanNA['lpg_leak']} onToggleNA={()=>toggleVanNA('lpg_leak')}/>
            {customLpgJobs.map(job=>(
              <div key={job.id} className="flex items-center gap-1">
                <div className="flex-1"><Checkbox checked={!!customLpgChecks[job.id]} onChange={v=>toggleLpgCheck(job.id,v)} label={job.label} isNA={!!vanNA[`lpgj_${job.id}`]} onToggleNA={()=>toggleVanNA(`lpgj_${job.id}`)}/></div>
                <button onClick={()=>removeLpgJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
              </div>
            ))}
            <div className="flex gap-2 mt-2 pt-3 border-t border-gray-100 mb-2">
              <input value={newLpgJob} onChange={e=>setNewLpgJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addLpgJob()} placeholder="Add custom check…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
              <button onClick={addLpgJob} disabled={!newLpgJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
            </div>
            <div className="mt-3 mb-3">
              <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Notes (optional)</label>
              <textarea value={lpgNotes} onChange={e=>setLpgNotes(e.target.value)} rows={2} className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none resize-none"/>
            </div>
            {lpgFlash?<OkMsg msg="✓ LPG check recorded!"/>:<Btn onClick={saveLPG} loading={saving} disabled={!Object.values(lpg).every(Boolean)}>Save LPG Check</Btn>}
          </Card>
          {lpgRecs.slice(0,3).map((r,i)=>(
            <Card key={i} className="p-3 mb-2 flex items-center gap-3">
              <div className="w-8 h-8 bg-green-100 rounded-xl flex items-center justify-center"><Icon name="fire" size={14} color="#16a34a"/></div>
              <div><p className="text-sm font-bold text-navy">{fmtDate(r.date)}</p><p className="text-xs text-green-600">All checks passed</p></div>
            </Card>
          ))}
        </div>
      )}
      {tab==='water'&&(
        <Card className="p-4 fade-in">
          <h3 className="font-bold text-navy text-sm mb-1">Water Tank Log</h3>
          {waterRecs[0]&&<p className="text-xs text-teal font-semibold mb-3">Last logged: {fmtDate(waterRecs[0].date)}</p>}
          <p className="text-xs text-gray-400 mb-4">Record potable water management</p>
          <Checkbox checked={water.filled} onChange={v=>setWater(p=>({...p,filled:v}))} label="Fresh water tank filled with potable water" isNA={!!vanNA['w_filled']} onToggleNA={()=>toggleVanNA('w_filled')}/>
          <Checkbox checked={water.cleaned} onChange={v=>setWater(p=>({...p,cleaned:v}))} label="Tank and pipes cleaned" isNA={!!vanNA['w_cleaned']} onToggleNA={()=>toggleVanNA('w_cleaned')}/>
          <Checkbox checked={water.san} onChange={v=>setWater(p=>({...p,san:v}))} label="Tank sanitised with appropriate solution" isNA={!!vanNA['w_san']} onToggleNA={()=>toggleVanNA('w_san')}/>
          {customWaterJobs.map(job=>(
            <div key={job.id} className="flex items-center gap-1">
              <div className="flex-1"><Checkbox checked={!!customWaterChecks[job.id]} onChange={v=>toggleWaterCheck(job.id,v)} label={job.label} isNA={!!vanNA[`wj_${job.id}`]} onToggleNA={()=>toggleVanNA(`wj_${job.id}`)}/></div>
              <button onClick={()=>removeWaterJob(job.id)} className="text-gray-300 hover:text-red-400 text-xl leading-none pb-3 flex-shrink-0">×</button>
            </div>
          ))}
          <div className="flex gap-2 mt-3 pt-3 border-t border-gray-100">
            <input value={newWaterJob} onChange={e=>setNewWaterJob(e.target.value)} onKeyDown={e=>e.key==='Enter'&&addWaterJob()} placeholder="Add custom check…" className="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:border-teal"/>
            <button onClick={addWaterJob} disabled={!newWaterJob.trim()} className="rounded-xl px-4 py-2 text-sm font-bold text-white disabled:opacity-30" style={{background:'#0D7377'}}>+</button>
          </div>
          <div className="mt-4">{waterFlash?<OkMsg msg="✓ Water log saved!"/>:<Btn onClick={saveWater} loading={saving}>Save Water Log</Btn>}</div>
        </Card>
      )}
      {tab==='pitch'&&(
        <div className="fade-in">
          <Card className="p-4 mb-4">
            <h3 className="font-bold text-navy text-sm mb-4">Log Today's Pitch</h3>
            <Input label="Event / Market name" value={pitchName} onChange={setPitchName} placeholder="e.g. Borough Market" required/>
            <Input label="Address" value={pitchAddr} onChange={setPitchAddr} placeholder="e.g. Southwark, London SE1"/>
            {pitchFlash?<OkMsg msg="✓ Pitch logged!"/>:<Btn onClick={savePitch} loading={saving} disabled={!pitchName}>Log pitch</Btn>}
          </Card>
          {pitches.length>0&&<>
            <p className="text-xs font-bold text-gray-400 uppercase tracking-wider px-1 mb-3">Pitch History</p>
            {pitches.map((r,i)=>(
              <Card key={i} className="p-3.5 mb-2 flex items-center gap-3">
                <div className="w-8 h-8 bg-teal-light rounded-xl flex items-center justify-center flex-shrink-0"><Icon name="location" size={14} color="#0D7377"/></div>
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-bold text-navy truncate">{r.name}</p>
                  <p className="text-xs text-gray-400">{fmtDate(r.date)}{r.address?` · ${r.address}`:''}</p>
                </div>
              </Card>
            ))}
          </>}
          {!pitches.length&&<p className="text-sm text-gray-400 text-center py-6">No pitches logged yet</p>}
        </div>
      )}
    </div>
  );
};

// ── EHO PACK ──────────────────────────────────────────────────────────────────
const RecordsScreen = ({userId,profile}) => {
  const [period,setPeriod]=useState('week');
  const [logType,setLogType]=useState('temps');
  const [records,setRecords]=useState([]);
  const [counts,setCounts]=useState({});
  const [passRate,setPassRate]=useState(0);
  const [todayPct,setTodayPct]=useState(0);
  const [loading,setLoading]=useState(true);
  const todayStr=today();

  const getCutoff=(p)=>{
    if(p==='today') return todayStr;
    if(p==='week') return new Date(Date.now()-7*864e5).toISOString().slice(0,10);
    if(p==='month') return new Date(Date.now()-30*864e5).toISOString().slice(0,10);
    return null;
  };

  useEffect(()=>{
    let ok=true;
    const load=async()=>{
      const cs=getCutoff(period);
      const ar=(q)=>period==='today'?q.eq('date',cs):cs?q.gte('date',cs):q;
      const mq=(t)=>ar(sb.from(t).select('*',{count:'exact',head:true}).eq('user_id',userId));
      const [dC,tC,cC,vC,lC,wC,pC,allT,tD,tT,tCl,tV]=await Promise.all([
        mq('diaries'),mq('temp_logs'),mq('cleaning_logs'),mq('van_checks'),
        mq('lpg_logs'),mq('water_logs'),mq('pitch_logs'),
        sb.from('temp_logs').select('pass').eq('user_id',userId),
        sb.from('diaries').select('id').eq('user_id',userId).eq('date',todayStr),
        sb.from('temp_logs').select('id').eq('user_id',userId).eq('date',todayStr),
        sb.from('cleaning_logs').select('id').eq('user_id',userId).eq('date',todayStr),
        sb.from('van_checks').select('id').eq('user_id',userId).eq('date',todayStr),
      ]);
      if(!ok) return;
      setCounts({diary:dC.count||0,temp:tC.count||0,clean:cC.count||0,van:vC.count||0,lpg:lC.count||0,water:wC.count||0,pitch:pC.count||0});
      const passing=(allT.data||[]).filter(t=>t.pass).length;
      setPassRate(allT.data?.length?Math.round((passing/allT.data.length)*100):0);
      const done=[!!(tD.data?.length),!!(tT.data?.length>=2),!!(tCl.data?.length),!!(tV.data?.length)].filter(Boolean).length;
      setTodayPct(Math.round((done/4)*100));
    };
    load();
    return()=>{ok=false;};
  },[userId,period]);

  useEffect(()=>{
    let ok=true;
    const load=async()=>{
      setLoading(true);
      setRecords([]);
      const cs=getCutoff(period);
      const tableMap={temps:'temp_logs',diary:'diaries',cleaning:'cleaning_logs',equipment:'van_checks',lpg:'lpg_logs',water:'water_logs',pitches:'pitch_logs'};
      const table=tableMap[logType];
      let q=sb.from(table).select('*').eq('user_id',userId).order('date',{ascending:false}).order('created_at',{ascending:false}).limit(100);
      if(period==='today') q=q.eq('date',cs);
      else if(cs) q=q.gte('date',cs);
      const{data}=await q;
      if(!ok) return;
      setRecords(data||[]);
      setLoading(false);
    };
    load();
    return()=>{ok=false;};
  },[userId,logType,period]);

  const total=Object.values(counts).reduce((a,b)=>a+b,0);

  const exportPack=async()=>{
    const w=window.open('','_blank');
    if(!w){alert('Pop-ups are blocked. Please allow pop-ups for this site and try again.');return;}
    w.document.write('<html><head><title>VanGuard</title></head><body style="font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#1A2744;color:white;font-size:18px;font-weight:bold">Loading your records...</body></html>');
    w.document.close();
    const cs=getCutoff(period);
    const ar=(q)=>period==='today'?q.eq('date',cs):cs?q.gte('date',cs):q;
    const mq=(t)=>ar(sb.from(t).select('*').eq('user_id',userId).order('date',{ascending:false}));
    const [{data:diaries},{data:temps},{data:cleans},{data:vans},{data:lpg},{data:waters},{data:pitches}]=await Promise.all([
      mq('diaries'),mq('temp_logs'),mq('cleaning_logs'),mq('van_checks'),mq('lpg_logs'),mq('water_logs'),mq('pitch_logs'),
    ]);
    const pLabel={today:'Today',week:'Last 7 days',month:'Last 30 days',all:'All time'}[period];
    const token=_getS()?.access_token||'';
    const biz=profile?.business_name||'VanGuard';
    const subject='Food Safety Records — '+biz+' ('+pLabel+')';
    const style=`*{box-sizing:border-box}body{font-family:Arial,Helvetica,sans-serif;margin:0;color:#111;background:#eef1f4}
.toolbar{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid #e5e7eb;padding:12px 16px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;box-shadow:0 1px 4px rgba(0,0,0,0.06)}
.btn{border:1px solid #e5e7eb;background:#fff;color:#1A2744;padding:11px 18px;border-radius:9px;font-size:14px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.btn:hover{background:#f6f8fa}.btn.primary{background:#0D7377;border-color:#0D7377;color:#fff}.btn.primary:hover{background:#0a5f63}
.btn.close{margin-left:auto;color:#6b7280}
.hint{max-width:820px;margin:10px auto 0;padding:0 22px;color:#94a3b8;font-size:12px}
#report{max-width:820px;margin:16px auto 40px;background:#fff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden}
.hdr{background:#1A2744;color:#fff;padding:22px 28px;display:flex;align-items:center;gap:14px}
.hdr img{width:46px;height:46px;border-radius:11px}
.hdr .t{font-size:21px;font-weight:800;line-height:1.1}.hdr .s{font-size:11px;color:#9fb3c8;letter-spacing:1.5px;text-transform:uppercase;margin-top:4px}
.meta{padding:16px 28px;background:#F8FAFC;border-bottom:1px solid #eef1f4;color:#475569;font-size:13px;line-height:1.8}
.bd{padding:20px 28px 8px}
h2{color:#0D7377;margin:24px 0 6px;font-size:15px}
table{width:100%;border-collapse:collapse;margin-top:6px;font-size:13px}
th{background:#F1F5F9;color:#334155;padding:9px 10px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:0.4px}
td{padding:8px 10px;border-bottom:1px solid #eef1f4}tr:nth-child(even) td{background:#fafbfc}
.pass{color:#16a34a;font-weight:bold}.fail{color:#dc2626;font-weight:bold}
.foot{padding:8px 28px 24px;color:#94a3b8;font-size:11px}
@media print{.toolbar,.hint{display:none!important}body{background:#fff}#report{border:none;margin:0;max-width:100%;border-radius:0}}`;
    const reportInner=`<div class="hdr"><img src="https://vanguardapp.co.uk/icon-192.png" alt="VanGuard"/><div><div class="t">Food Safety Records</div><div class="s">VanGuard · vanguardapp.co.uk</div></div></div>
<div class="meta"><strong>Business:</strong> ${biz} &nbsp;|&nbsp; <strong>Operator:</strong> ${profile?.name||'—'} &nbsp;|&nbsp; <strong>Authority:</strong> ${profile?.authority||'—'}<br>
<strong>Period:</strong> ${pLabel} &nbsp;|&nbsp; <strong>Total records:</strong> ${total} &nbsp;|&nbsp; <strong>Temp pass rate:</strong> ${passRate}% &nbsp;|&nbsp; <strong>Exported:</strong> ${new Date().toLocaleString('en-GB')}</div>
<div class="bd">
${diaries?.length?`<h2>Daily Diary (${diaries.length} entries)</h2><table><tr><th>Date</th><th>Location</th><th>Opening</th><th>Closing</th><th>Issues</th></tr>${diaries.map(d=>`<tr><td>${fmtDate(d.date)}</td><td>${d.location||'-'}</td><td>${Object.values(d.opening||{}).filter(Boolean).length}/4</td><td>${Object.values(d.closing||{}).filter(Boolean).length}/4</td><td>${d.issues||'None'}</td></tr>`).join('')}</table>`:''}
${temps?.length?`<h2>Temperature Log (${temps.length} readings)</h2><table><tr><th>Date</th><th>Time</th><th>Unit</th><th>Temp</th><th>Result</th><th>Action</th></tr>${temps.map(t=>`<tr><td>${fmtDate(t.date)}</td><td>${t.time}</td><td>${t.unit}</td><td>${t.temp}°C</td><td class="${t.pass?'pass':'fail'}">${t.pass?'PASS':'FAIL'}</td><td>${t.action||'-'}</td></tr>`).join('')}</table>`:''}
${cleans?.length?`<h2>Cleaning Records (${cleans.length})</h2><table><tr><th>Date</th><th>Items completed</th><th>Signed by</th></tr>${cleans.map(c=>`<tr><td>${fmtDate(c.date)}</td><td>${Object.values(c.checks||{}).filter(Boolean).length}/8 items</td><td>${c.saved_by||'-'}</td></tr>`).join('')}</table>`:''}
${vans?.length?`<h2>Unit / Van Checks (${vans.length})</h2><table><tr><th>Date</th><th>Items</th><th>Checked by</th></tr>${vans.map(v=>`<tr><td>${fmtDate(v.date)}</td><td>${Object.values(v.checks||{}).filter(Boolean).length}/8</td><td>${v.signed_by||'-'}</td></tr>`).join('')}</table>`:''}
${lpg?.length?`<h2>LPG Safety (${lpg.length})</h2><table><tr><th>Date</th><th>Result</th><th>Notes</th></tr>${lpg.map(l=>`<tr><td>${fmtDate(l.date)}</td><td class="pass">Passed</td><td>${l.notes||'-'}</td></tr>`).join('')}</table>`:''}
${waters?.length?`<h2>Water Records (${waters.length})</h2><table><tr><th>Date</th><th>Filled</th><th>Cleaned</th><th>Sanitised</th></tr>${waters.map(w=>`<tr><td>${fmtDate(w.date)}</td><td>${w.filled?'Yes':'-'}</td><td>${w.cleaned?'Yes':'-'}</td><td>${w.sanitised?'Yes':'-'}</td></tr>`).join('')}</table>`:''}
${pitches?.length?`<h2>Pitch Log (${pitches.length})</h2><table><tr><th>Date</th><th>Location</th><th>Address</th></tr>${pitches.map(p=>`<tr><td>${fmtDate(p.date)}</td><td>${p.name}</td><td>${p.address||'-'}</td></tr>`).join('')}</table>`:''}
</div>
<p class="foot">Generated by VanGuard · vanguardapp.co.uk</p>`;
    w.document.open();
    w.document.write(`<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Food Safety Records — ${biz}</title><style>${style}</style></head><body>
<div class="toolbar">
  <button class="btn primary" onclick="window.print()">⤓ Save as PDF</button>
  <button class="btn" onclick="window.print()">🖨 Print</button>
  <button class="btn" id="emailBtn" onclick="emailReport()">✉ Email report</button>
  <button class="btn close" onclick="window.close()">Close</button>
</div>
<div class="hint">In the print dialog, choose your printer, or set the destination to “Save as PDF”.</div>
<div id="report">${reportInner}</div>
<script>
var TOKEN=${JSON.stringify(token)};var SUBJECT=${JSON.stringify(subject)};var STYLE=${JSON.stringify(style)};var ENDPOINT=${JSON.stringify(location.origin+'/.netlify/functions/send-records')};
function emailReport(){
  var to=prompt("Send these records to which email address?","");
  if(!to){return;}
  var btn=document.getElementById("emailBtn");
  if(btn){btn.disabled=true;btn.textContent="Sending…";}
  var body="<div style=\\"font-family:Arial,sans-serif;background:#eef1f4;padding:20px\\"><style>"+STYLE+"</style>"+document.getElementById("report").outerHTML+"</div>";
  fetch(ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({to:to,subject:SUBJECT,html:body,token:TOKEN})})
    .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j};});})
    .then(function(res){ if(res.ok){alert("Records sent to "+to);}else{alert("Could not send: "+((res.j&&res.j.error)||"please try again"));} if(btn){btn.disabled=false;btn.textContent="✉ Email report";} })
    .catch(function(){ alert("Could not send. Please check your connection and try again."); if(btn){btn.disabled=false;btn.textContent="✉ Email report";} });
}
</script>
</body></html>`);
    w.document.close();
  };

  const LOG_TYPES=[
    {key:'temps',label:'Temps',cnt:counts.temp},
    {key:'diary',label:'Diary',cnt:counts.diary},
    {key:'cleaning',label:'Cleaning',cnt:counts.clean},
    {key:'equipment',label:'Equipment',cnt:counts.van},
    {key:'lpg',label:'LPG',cnt:counts.lpg},
    {key:'water',label:'Water',cnt:counts.water},
    {key:'pitches',label:'Pitches',cnt:counts.pitch},
  ];

  const sc=todayPct===100?'green':todayPct>=50?'amber':'red';
  const sBg={green:'bg-green-50 border-green-100',amber:'bg-amber-50 border-amber-100',red:'bg-red-50 border-red-100'}[sc];
  const sTxt={green:'text-green-700',amber:'text-amber-700',red:'text-red-700'}[sc];
  const sRing={green:'#16a34a',amber:'#d97706',red:'#ef4444'}[sc];

  const renderRecord=(r)=>{
    const base="py-3 border-b border-gray-50 last:border-0 flex items-center gap-3";
    if(logType==='temps') return (
      <div key={r.id} className={base}>
        <div className={`w-2 h-2 rounded-full flex-shrink-0 ${r.pass?'bg-green-400':'bg-red-400'}`}/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800 truncate">{r.unit}</p>
          <p className="text-xs text-gray-400">{fmtDate(r.date)} · {r.time}</p>
          {r.action&&<p className="text-xs text-amber-600 truncate mt-0.5">Action: {r.action}</p>}
        </div>
        <div className="flex-shrink-0 text-right">
          <p className="text-sm font-bold text-gray-800">{r.temp}°C</p>
          <Badge label={r.pass?'PASS':'FAIL'} color={r.pass?'green':'red'}/>
        </div>
      </div>
    );
    if(logType==='diary') return (
      <div key={r.id} className={base+" items-start"}>
        <div className="w-2 h-2 rounded-full bg-navy flex-shrink-0 mt-1.5"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{fmtDate(r.date)}</p>
          <p className="text-xs text-gray-400 truncate">{r.location||'No location'}</p>
          {r.issues&&<p className="text-xs text-amber-600 truncate mt-0.5">Issue: {r.issues}</p>}
        </div>
        <div className="flex-shrink-0 text-right text-xs text-gray-500 mt-0.5">
          <p>{Object.values(r.opening||{}).filter(Boolean).length}/4 open</p>
          <p>{Object.values(r.closing||{}).filter(Boolean).length}/4 close</p>
        </div>
      </div>
    );
    if(logType==='cleaning') return (
      <div key={r.id} className={base}>
        <div className="w-2 h-2 rounded-full bg-teal flex-shrink-0"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{fmtDate(r.date)}</p>
          <p className="text-xs text-gray-400">{Object.values(r.checks||{}).filter(Boolean).length}/8 items</p>
        </div>
        <span className="flex-shrink-0 text-xs text-gray-400">{r.saved_by||'—'}</span>
      </div>
    );
    if(logType==='equipment') return (
      <div key={r.id} className={base}>
        <div className="w-2 h-2 rounded-full bg-teal flex-shrink-0"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{fmtDate(r.date)}</p>
          <p className="text-xs text-gray-400">{Object.values(r.checks||{}).filter(Boolean).length}/8 checks</p>
        </div>
        <span className="flex-shrink-0 text-xs text-gray-400">{r.signed_by||'—'}</span>
      </div>
    );
    if(logType==='lpg') return (
      <div key={r.id} className={base}>
        <div className="w-2 h-2 rounded-full bg-teal flex-shrink-0"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{fmtDate(r.date)}</p>
          {r.notes&&<p className="text-xs text-gray-400 truncate">{r.notes}</p>}
        </div>
        <Badge label="✓ Passed" color="green"/>
      </div>
    );
    if(logType==='water') return (
      <div key={r.id} className={base}>
        <div className="w-2 h-2 rounded-full bg-teal flex-shrink-0"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{fmtDate(r.date)}</p>
          <p className="text-xs text-gray-400">{[r.filled&&'Filled',r.cleaned&&'Cleaned',r.sanitised&&'Sanitised'].filter(Boolean).join(' · ')||'—'}</p>
        </div>
      </div>
    );
    if(logType==='pitches') return (
      <div key={r.id} className={base}>
        <div className="w-2 h-2 rounded-full bg-navy flex-shrink-0"/>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-semibold text-gray-800">{r.name}</p>
          <p className="text-xs text-gray-400">{fmtDate(r.date)}{r.address&&` · ${r.address}`}</p>
        </div>
      </div>
    );
    return null;
  };

  return (
    <div className="pt-28 pb-8 px-4">
      <div className={`rounded-2xl p-4 mb-4 border flex items-center gap-4 ${sBg}`}>
        <div className="relative flex-shrink-0" style={{width:'56px',height:'56px'}}>
          <svg width="56" height="56" viewBox="0 0 56 56">
            <circle cx="28" cy="28" r="24" fill="none" stroke="#FFFFFF" strokeWidth="6"/>
            <circle cx="28" cy="28" r="24" fill="none" stroke={sRing} strokeWidth="6" strokeLinecap="round"
              strokeDasharray={2*Math.PI*24} strokeDashoffset={2*Math.PI*24*(1-todayPct/100)} transform="rotate(-90 28 28)"/>
          </svg>
          <div className="absolute inset-0 flex items-center justify-center">
            <span className={`text-sm font-black ${sTxt}`}>{todayPct}%</span>
          </div>
        </div>
        <div className="flex-1 min-w-0">
          <p className={`font-bold text-sm ${sTxt}`}>{todayPct===100?'EHO-ready for today':todayPct>0?'Some checks outstanding':'No checks logged today'}</p>
          <p className="text-xs text-gray-500 mt-0.5">Across diary, temps, cleaning &amp; equipment</p>
        </div>
      </div>
      <Btn onClick={exportPack} variant="navy" className="mb-4"><Icon name="download" size={16} color="white"/>Export / email records</Btn>
      <div className="grid grid-cols-4 gap-1.5 mb-4">
        {[['today','Today'],['week','This week'],['month','Month'],['all','All time']].map(([p,l])=>(
          <button key={p} onClick={()=>setPeriod(p)}
            className={`py-2 rounded-xl text-xs font-bold border-2 transition-all ${period===p?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>{l}</button>
        ))}
      </div>
      <div className="flex gap-2 overflow-x-auto pb-2 mb-4 -mx-1 px-1" style={{scrollbarWidth:'none',msOverflowStyle:'none'}}>
        {LOG_TYPES.map(t=>(
          <button key={t.key} onClick={()=>setLogType(t.key)}
            className={`flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-bold border transition-all ${logType===t.key?'bg-navy border-navy text-white':'bg-white border-gray-200 text-gray-600'}`}>
            {t.label}{t.cnt>0?` (${t.cnt})`:''}
          </button>
        ))}
      </div>
      <Card className="p-4 mb-4">
        {loading
          ?<Spinner/>
          :records.length===0
            ?<div className="text-center py-8">
              <p className="text-4xl mb-2">📭</p>
              <p className="text-sm text-gray-400">No {LOG_TYPES.find(t=>t.key===logType)?.label.toLowerCase()} records for this period</p>
            </div>
            :<div>
              <p className="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">{records.length} record{records.length!==1?'s':''}</p>
              {records.map(r=>renderRecord(r))}
            </div>
        }
      </Card>
      <Card className="p-4 mb-4">
        <div className="flex justify-between items-center mb-1">
          <h3 className="font-bold text-navy text-sm">Export EHO Pack</h3>
          <span className="text-xs text-gray-400">{total} total records</span>
        </div>
        <p className="text-xs text-gray-400 mb-3">All record types for the selected period. Save as PDF, print, or email to your EHO or team.</p>
        <Btn onClick={exportPack} variant="navy"><Icon name="download" size={16} color="white"/>Export / email records</Btn>
        <p className="text-xs text-gray-400 text-center mt-2">Opens a printable page · save as PDF</p>
      </Card>
      <div className="grid grid-cols-2 gap-3">
        <Card className="p-4"><p className="text-2xl font-black text-teal">{passRate}%</p><p className="text-xs text-gray-400 mt-1">Temperature pass rate</p></Card>
        <Card className="p-4"><p className="text-2xl font-black text-teal">{total}</p><p className="text-xs text-gray-400 mt-1">Records this period</p></Card>
      </div>
    </div>
  );
};

// ── FEEDBACK CARD ─────────────────────────────────────────────────────────────
const FeedbackCard = ({userId,email}) => {
  const [msg,setMsg]=useState('');
  const [sent,setSent]=useState(false);
  const [sending,setSending]=useState(false);
  const send=async()=>{
    if(!msg.trim())return;
    setSending(true);
    await sb.from('feedback').insert({user_id:userId,email,message:msg.trim()});
    setSending(false);setSent(true);setMsg('');
    setTimeout(()=>setSent(false),5000);
  };
  return (
    <Card className="p-4 mt-4">
      <div className="flex items-center gap-3 mb-3">
        <div className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={{background:'#EAF6F6'}}>
          <Icon name="chat" size={18} color="#0D7377"/>
        </div>
        <div>
          <p className="font-bold text-navy text-sm">Feedback & suggestions</p>
          <p className="text-xs text-gray-400">We read every message, and aim to add requested features within a week.</p>
        </div>
      </div>
      {sent?(
        <div className="bg-green-50 border border-green-100 rounded-xl p-3 text-center">
          <p className="text-green-700 text-sm font-semibold">Thank you — we've got it. 🙌</p>
          <p className="text-green-600 text-xs mt-0.5">We read everything and will be in touch if we need more detail.</p>
        </div>
      ):(<>
        <textarea value={msg} onChange={e=>setMsg(e.target.value)} rows={3}
          placeholder="What would make VanGuard better for you? Bugs, ideas or feature requests all welcome…"
          className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-gray-50 focus:outline-none focus:border-teal resize-none mb-2"/>
        <Btn onClick={send} loading={sending}>Send feedback</Btn>
      </>)}
    </Card>
  );
};

// ── ACCOUNT ───────────────────────────────────────────────────────────────────
const AccountScreen = ({userId,profile,onUpdate}) => {
  const [section,setSection]=useState('profile');
  const [name,setName]=useState(profile?.name||'');
  const [biz,setBiz]=useState(profile?.business_name||'');
  const [unitType,setUnitType]=useState(profile?.unit_type||'van');
  const [authority,setAuthority]=useState(profile?.authority||'');
  const [lpgEnabled,setLpgEnabled]=useState(profile?.lpg_enabled!==false);
  const [waterEnabled,setWaterEnabled]=useState(profile?.water_enabled??false);
  const [teamSize,setTeamSize]=useState(profile?.team_size||'solo');
  const [foodType,setFoodType]=useState(profile?.food_type||'');
  const [hygieneRating,setHygieneRating]=useState(profile?.hygiene_rating??null);
  // Keep the form in sync when the profile loads/changes (e.g. name from signup).
  useEffect(()=>{
    setName(profile?.name||'');
    setBiz(profile?.business_name||'');
    setUnitType(profile?.unit_type||'van');
    setAuthority(profile?.authority||'');
    setLpgEnabled(profile?.lpg_enabled!==false);
    setWaterEnabled(profile?.water_enabled??false);
    setTeamSize(profile?.team_size||'solo');
    setFoodType(profile?.food_type||'');
    setHygieneRating(profile?.hygiene_rating??null);
  },[profile?.id]);
  const [saving,setSaving]=useState(false);
  const [flash,setFlash]=useState('');
  const [newPass,setNewPass]=useState('');
  const [passFlash,setPassFlash]=useState('');
  const [passErr,setPassErr]=useState('');
  const [passLoading,setPassLoading]=useState(false);
  const saveProfile=async()=>{
    setSaving(true);
    const{data}=await sb.from('profiles').update({name,business_name:biz,unit_type:unitType,authority,lpg_enabled:lpgEnabled,water_enabled:waterEnabled,team_size:teamSize,food_type:foodType,hygiene_rating:hygieneRating}).eq('id',userId).select().single();
    if(data) onUpdate(data);
    setFlash('Profile saved!'); setTimeout(()=>setFlash(''),2000); setSaving(false);
  };
  const changePass=async()=>{
    setPassErr(''); setPassFlash('');
    if(newPass.length<6){setPassErr('Password must be at least 6 characters.');return;}
    setPassLoading(true);
    const{error}=await sb.auth.updatePassword(newPass);
    if(error){setPassErr(error.message);} else {setPassFlash('Password updated!');setNewPass('');}
    setPassLoading(false);
  };
  const logout=async()=>{await sb.auth.signOut();};
  const [subLoading,setSubLoading]=useState('');
  const isActive=profile?.subscription_status==='active';
  const isLifetime=profile?.subscription_status==='lifetime';
  const isTrialing=profile?.subscription_status==='trialing';
  const isPastDue=profile?.subscription_status==='past_due';
  const hasStripe=!!profile?.stripe_customer_id;
  const trialDays=profile?.trial_start?Math.floor((new Date()-new Date(profile.trial_start))/86400000):0;
  const trialLeft=isTrialing?Math.max(0,14-trialDays):0;
  const isYearly=profile?.plan_interval==='year';
  const planName=isYearly?'Yearly plan':'Monthly plan';
  const planPrice=isYearly?'£69.99/year':'£7.99/month';
  const cancelling=!!profile?.cancel_at_period_end;
  const periodEnd=profile?.period_end?new Date(profile.period_end):null;
  const fmtEnd=periodEnd&&!isNaN(periodEnd)?periodEnd.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}):null;
  const subscribe=async(plan='monthly')=>{
    setSubLoading(plan);
    try{
      const tok=_getS()?.access_token;
      const res=await fetch('/.netlify/functions/create-checkout',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},
        body:JSON.stringify({userId,email:profile?.email||_getS()?.user?.email,trial:false}),
      });
      const {url,error}=await res.json();
      if(error)throw new Error(error);
      window.location.href=url;
    } catch(e){
      alert('Could not start checkout: '+e.message);
      setSubLoading('');
    }
  };
  const [portalLoading,setPortalLoading]=useState(false);
  const openPortal=async()=>{
    setPortalLoading(true);
    try{
      const tok=_getS()?.access_token;
      const res=await fetch('/.netlify/functions/create-portal',{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},
        body:JSON.stringify({userId}),
      });
      const {url,error}=await res.json();
      if(error)throw new Error(error);
      window.location.href=url;
    } catch(e){
      alert('Could not open the billing portal: '+e.message);
      setPortalLoading(false);
    }
  };
  const [notifStatus,setNotifStatus]=useState('checking');
  const [notifLoading,setNotifLoading]=useState(false);
  useEffect(()=>{
    if(!('serviceWorker' in navigator)||!('PushManager' in window)){setNotifStatus('unsupported');return;}
    if(Notification.permission==='denied'){setNotifStatus('denied');return;}
    navigator.serviceWorker.ready.then(r=>r.pushManager.getSubscription()).then(sub=>{
      setNotifStatus(sub?'subscribed':'unsubscribed');
    }).catch(()=>setNotifStatus('unsubscribed'));
  },[]);
  const enableNotifs=async()=>{
    setNotifLoading(true);
    try{
      const perm=await Notification.requestPermission();
      if(perm!=='granted'){setNotifStatus('denied');setNotifLoading(false);return;}
      const reg=await navigator.serviceWorker.ready;
      const sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:urlBase64ToUint8(VAPID_PUBLIC_KEY)});
      const tok=_getS()?.access_token;
      await fetch('/.netlify/functions/push-subscribe',{method:'POST',headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},body:JSON.stringify({subscription:sub.toJSON(),action:'subscribe'})}).catch(()=>{});
      setNotifStatus('subscribed');
    }catch{setNotifStatus('unsubscribed');}
    setNotifLoading(false);
  };
  const disableNotifs=async()=>{
    setNotifLoading(true);
    try{
      const reg=await navigator.serviceWorker.ready;
      const sub=await reg.pushManager.getSubscription();
      if(sub){
        const tok=_getS()?.access_token;
        await fetch('/.netlify/functions/push-subscribe',{method:'POST',headers:{'Content-Type':'application/json','Authorization':`Bearer ${tok}`},body:JSON.stringify({subscription:sub.toJSON(),action:'unsubscribe'})}).catch(()=>{});
        await sub.unsubscribe();
      }
      setNotifStatus('unsubscribed');
    }catch{}
    setNotifLoading(false);
  };
  const sections=[{k:'profile',l:'Profile',icon:'user'},{k:'security',l:'Security',icon:'lock'},{k:'subscription',l:'Plan',icon:'star'},{k:'notifications',l:'Reminders',icon:'bell'}];
  return (
    <div className="pt-28 pb-8 px-4">
      {/* Profile summary */}
      <Card className="p-4 mb-5">
        <div className="flex items-center gap-3">
          <div className="w-12 h-12 bg-navy rounded-xl flex items-center justify-center flex-shrink-0">
            <span className="text-white font-black text-base">{(profile?.name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase()}</span>
          </div>
          <div className="flex-1 min-w-0">
            <p className="font-bold text-navy truncate">{profile?.name||'Your Name'}</p>
            <p className="text-xs text-gray-400 truncate">{profile?.business_name||'Your Business'}</p>
            {profile?.hygiene_rating!=null&&(()=>{
              const r=profile.hygiene_rating;
              const col=r>=4?'#16a34a':r>=3?'#d97706':'#ef4444';
              return <p className="text-xs font-bold mt-0.5" style={{color:col}}>{'★'.repeat(r)}{'☆'.repeat(5-r)} {r}/5 food hygiene</p>;
            })()}
          </div>
          {isLifetime?<Badge label="Founding Member" color="teal"/>:isActive?<Badge label="Active" color="green"/>:trialLeft>0?<Badge label={`Trial: ${trialLeft}d`} color="amber"/>:<Badge label="Expired" color="red"/>}
        </div>
        <div className="mt-3 pt-3 border-t border-gray-100">
          <button onClick={logout} className="w-full flex items-center gap-2 py-2 text-red-500 font-semibold text-sm active:opacity-60">
            <Icon name="logout" size={16} color="#ef4444"/>
            Sign out
          </button>
        </div>
      </Card>
      {/* ── Refer a friend (top for visibility) ── */}
      {(isActive||isLifetime||trialLeft>0)&&(
      <Card className="p-4 mb-5 border-2" style={{borderColor:'#FDE68A',background:'#FFFBEB'}}>
        <div className="flex items-center gap-3 mb-3">
          <div className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={{background:'#FFF3E0'}}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <p className="font-bold text-navy text-sm">Refer a friend — get 2 months free</p>
            <p className="text-xs text-gray-500">Share your link. When a friend starts their free trial, you get 2 months credited to your subscription.</p>
          </div>
        </div>
        {(()=>{
          const refCode=userId.slice(0,8);
          const refUrl=`https://vanguardapp.co.uk?ref=${refCode}`;
          const [copied,setCopied]=useState(false);
          const copy=()=>{
            navigator.clipboard.writeText(refUrl).then(()=>{
              setCopied(true); setTimeout(()=>setCopied(false),2000);
            });
          };
          return (
            <div>
              <div className="flex items-center gap-2 bg-white/70 rounded-xl px-3 py-2 mb-2">
                <p className="text-xs text-gray-600 flex-1 truncate font-mono">{refUrl}</p>
              </div>
              <Btn onClick={copy} variant={copied?'primary':'outline'} className="w-full">
                {copied?'✓ Copied!':'Copy referral link'}
              </Btn>
            </div>
          );
        })()}
      </Card>
      )}
      {/* Section tabs */}
      <div className="grid grid-cols-4 gap-1.5 mb-5">
        {sections.map(s=>(
          <button key={s.k} onClick={()=>setSection(s.k)}
            className={`flex flex-col items-center gap-1 py-3 rounded-xl border-2 transition-all ${section===s.k?'bg-navy border-navy text-white':'bg-white border-gray-100 text-gray-500'}`}>
            <Icon name={s.icon} size={16} color={section===s.k?'white':'#9CA3AF'}/>
            <span className="text-[10px] font-bold">{s.l}</span>
          </button>
        ))}
      </div>
      {section==='profile'&&(
        <Card className="p-4 fade-in">
          <h3 className="font-bold text-navy text-sm mb-4">Business Profile</h3>
          <Input label="Your name" value={name} onChange={setName} placeholder="Full name"/>
          <Input label="Business / trading name" value={biz} onChange={setBiz} placeholder="e.g. The Taco Van"/>
          <Input label="Local authority" value={authority} onChange={setAuthority} placeholder="e.g. Southwark Council"/>
          <div className="mb-4">
            <label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Unit type</label>
            <div className="grid grid-cols-2 gap-2">
              {unitTypes.map(u=>(
                <button key={u.key} onClick={()=>setUnitType(u.key)}
                  className={`py-2.5 px-3 rounded-xl text-sm font-semibold border-2 text-left transition-all ${unitType===u.key?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                  {u.emoji} {u.label}
                </button>
              ))}
            </div>
          </div>
          <div className="flex items-center justify-between py-3 border-b border-gray-100">
            <div>
              <p className="text-sm font-semibold text-navy">LPG / Gas equipment</p>
              <p className="text-xs text-gray-400">Show LPG safety checks in Van screen</p>
            </div>
            <button onClick={()=>setLpgEnabled(p=>!p)}
              className={`relative w-12 h-6 rounded-full transition-colors ${lpgEnabled?'bg-teal':'bg-gray-200'}`}>
              <div className={`absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all ${lpgEnabled?'left-6':'left-0.5'}`}/>
            </button>
          </div>
          <div className="flex items-center justify-between py-3 border-b border-gray-100">
            <div>
              <p className="text-sm font-semibold text-navy">Water tank on board</p>
              <p className="text-xs text-gray-400">Show water tank checks in Van screen</p>
            </div>
            <button onClick={()=>setWaterEnabled(p=>!p)}
              className={`relative w-12 h-6 rounded-full transition-colors ${waterEnabled?'bg-teal':'bg-gray-200'}`}>
              <div className={`absolute top-0.5 w-5 h-5 bg-white rounded-full shadow transition-all ${waterEnabled?'left-6':'left-0.5'}`}/>
            </button>
          </div>
          <div className="py-3 border-b border-gray-100">
            <p className="text-sm font-semibold text-navy mb-2">Who runs the unit?</p>
            <div className="grid grid-cols-2 gap-2">
              {[{v:'solo',l:'Just me'},{v:'team',l:'Me + staff'}].map(o=>(
                <button key={o.v} onClick={()=>setTeamSize(o.v)}
                  className={`py-2.5 rounded-xl text-sm font-semibold border-2 transition-all ${teamSize===o.v?'bg-teal border-teal text-white':'bg-gray-50 border-gray-100 text-gray-600'}`}>
                  {o.l}
                </button>
              ))}
            </div>
          </div>
          <div className="py-3 border-b border-gray-100 mb-1">
            <Input label="What you mainly serve" value={foodType} onChange={setFoodType} placeholder="e.g. Burgers, coffee, tacos"/>
          </div>
          <div className="py-3 border-b border-gray-100 mb-4">
            <p className="text-sm font-semibold text-navy mb-1">Food hygiene rating</p>
            <p className="text-xs text-gray-400 mb-2">Your current FSA rating (0–5 stars)</p>
            <div className="flex gap-1.5">
              {[1,2,3,4,5].map(v=>{
                const active=hygieneRating===v;
                const col=v>=4?'#16a34a':v===3?'#d97706':'#ef4444';
                return(
                  <button key={v} onClick={()=>setHygieneRating(active?null:v)}
                    className="flex-1 py-2 rounded-xl text-sm font-bold border-2 transition-all"
                    style={{background:active?col:'#F9FAFB',borderColor:active?col:'#E5E7EB',color:active?'white':col}}>
                    {v}★
                  </button>
                );
              })}
            </div>
            {hygieneRating===null&&<p className="text-xs text-gray-400 mt-1">Not set — tap to select</p>}
          </div>
          {flash?<OkMsg msg={flash}/>:<Btn onClick={saveProfile} loading={saving}>Save profile</Btn>}
        </Card>
      )}
      {section==='security'&&(
        <Card className="p-4 fade-in">
          <h3 className="font-bold text-navy text-sm mb-1">Change Password</h3>
          <p className="text-xs text-gray-400 mb-4">Set a new password for your account</p>
          <ErrMsg msg={passErr}/>
          <Input label="New password" value={newPass} onChange={setNewPass} type="password" placeholder="Min. 6 characters" hint="Must be at least 6 characters"/>
          {passFlash?<OkMsg msg={passFlash}/>:<Btn onClick={changePass} loading={passLoading}>Update password</Btn>}
        </Card>
      )}
      {section==='subscription'&&(
        <div className="fade-in">
          {/* ── Founding member ── */}
          {isLifetime&&(
            <Card className="p-4 mb-4 border-2 border-teal">
              <div className="flex items-center gap-3 mb-3">
                <div className="w-10 h-10 bg-teal rounded-xl flex items-center justify-center flex-shrink-0">
                  <Icon name="star" size={18} color="white"/>
                </div>
                <div>
                  <p className="font-bold text-navy text-sm">Founding Member</p>
                  <p className="text-xs text-teal font-semibold">Lifetime access · Thank you!</p>
                </div>
              </div>
              <p className="text-xs text-gray-500">You're one of our founding members. You have full access to VanGuard forever, including all future features.</p>
            </Card>
          )}
          {/* ── Monthly active ── */}
          {isActive&&(
            <Card className="p-4 mb-4">
              <div className="flex items-center gap-3 mb-4">
                <div className="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                  <Icon name="star" size={18} color="#16a34a"/>
                </div>
                <div>
                  <p className="font-bold text-navy text-sm">{planName}</p>
                  <p className="text-xs text-gray-400">{planPrice} · Active</p>
                </div>
              </div>
              {cancelling?(
                <div className="bg-amber-50 border border-amber-100 rounded-xl p-3 mb-3">
                  <p className="text-amber-700 text-sm font-semibold">Subscription cancelled</p>
                  <p className="text-amber-600 text-xs mt-0.5">{fmtEnd?`Your access stays active until ${fmtEnd}, then your account will pause.`:'Your access stays active until the end of your current billing period.'}</p>
                </div>
              ):fmtEnd&&(
