<style>
* { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #F8FAFC; overscroll-behavior: none; overflow-x: hidden; }
input, textarea, button { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; }
.fade-in { animation: fadeIn 0.2s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
::-webkit-scrollbar { display: none; }
/* Desktop polish: frame the centred app column against a branded backdrop so it
   reads as an intentional desktop layout rather than a stranded mobile view. */
@media (min-width: 768px) {
  body { background: #0c1428; background: linear-gradient(160deg, #1A2744 0%, #0c1428 70%); background-attachment: fixed; }
  .app-shell { background: #F8FAFC; box-shadow: 0 0 0 1px rgba(255,255,255,0.05), 0 24px 70px rgba(0,0,0,0.45); }
}
/* Desktop (≥1024px): full sidebar layout, no fixed mobile nav gap. */
@media (min-width: 1024px) {
  body { background: #F1F5F9; }
  .app-shell { box-shadow: none; background: #F1F5F9; }
  .vg-content > div { padding-top: 2rem !important; }
}
.tab-active { color: #0D7377 !important; border-bottom-color: #0D7377 !important; }
@keyframes fab-glow {
  0%,100% { box-shadow: 0 0 0 0 rgba(13,115,119,0.55), 0 4px 18px rgba(13,115,119,0.35); transform: scale(1); }
  50%      { box-shadow: 0 0 0 8px rgba(13,115,119,0),  0 6px 30px rgba(13,115,119,0.65); transform: scale(1.07); }
}
@keyframes fab-ring {
  0%   { transform: scale(1);   opacity: 0.65; }
  100% { transform: scale(2.4); opacity: 0; }
}
.fab-glow { animation: fab-glow 2.4s ease-in-out infinite; }
.fab-ring { position:absolute; inset:0; border-radius:50%; background:rgba(13,115,119,0.45); pointer-events:none; animation: fab-ring 2.4s ease-out infinite; }
.fab-ring-2 { animation-delay: 1.2s; }
@media (max-width: 519px) {
  .hero-cols { flex-direction: column !important; min-height: unset !important; }
  .hero-left  { flex: none !important; width: 100% !important; padding: 28px 20px 16px !important; align-items: center !important; text-align: center !important; }
  .hero-left .hero-logo-row { justify-content: center; }
  .hero-right { flex: none !important; width: 100% !important; padding: 0 0 20px !important; }
  .hero-divider { display: none !important; }
}
/* Demo mode banner: fixed full-width top bar; offset nav + content so nothing overlaps. */
.vg-demo-banner { position: fixed; top: 0; left: 0; right: 0; z-index: 60; box-shadow: 0 2px 8px rgba(0,0,0,0.18); }
body.vg-demo .vg-topnav { top: 44px !important; }
body.vg-demo .vg-sidebar { top: 44px !important; height: calc(100vh - 44px) !important; }
body.vg-demo .vg-content { padding-top: 44px; }
</style>
