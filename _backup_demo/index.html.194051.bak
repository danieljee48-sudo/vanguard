            </div>
          ))}
        </div>
      </div>

      {/* ── PRICING ── */}
      <div style={{background:'#F8FAFB'}} className="px-5 py-10">
        <h2 className="text-xl font-black text-center mb-1" style={{color:'#1A2744'}}>Simple pricing.</h2>
        <p className="text-gray-400 text-sm text-center mb-6">No hidden fees.</p>

        {/* Monthly — featured */}
        <div className="rounded-2xl p-5 mb-4 border-2 relative overflow-hidden" style={{background:'#1A2744',borderColor:'#0D7377'}}>
          <div className="absolute top-3 right-3 text-xs font-bold px-2 py-0.5 rounded-full" style={{background:'#0D7377',color:'white'}}>
            ⭐ 14 days free
          </div>
          <p className="text-xs font-bold tracking-wider mb-3" style={{color:'#0D7377'}}>SOLO PLAN</p>
          <div className="flex items-end gap-1 mb-1">
            <span className="text-4xl font-black text-white">£7.99</span>
            <span className="text-white/40 text-sm mb-1">/month</span>
          </div>
          <p className="text-sm font-semibold mb-1" style={{color:'#4ECDC4'}}>Free for your first 14 days.</p>
          <p className="text-xs mb-1" style={{color:'rgba(255,255,255,0.55)'}}>or <strong>£69.99/year</strong> — save 27%</p>
          <p className="text-xs mb-4" style={{color:'rgba(255,255,255,0.4)'}}>Cancel anytime before your trial ends and you won't be charged</p>
          <button onClick={()=>onGetStarted('register')}
            className="w-full py-3.5 rounded-xl font-bold text-white text-sm"
            style={{background:'#0D7377'}}>
            Start Free Trial
          </button>
