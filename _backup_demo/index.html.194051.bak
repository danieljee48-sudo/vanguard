// ── SHARED UI ─────────────────────────────────────────────────────────────────
const Spinner = ({full}) => (
  <div className={`flex items-center justify-center ${full?'h-64':'py-8'}`}>
    <div className="w-7 h-7 border-2 border-teal/20 border-t-teal rounded-full animate-spin"/>
  </div>
);
const Card = ({children,className=''}) => <div className={`bg-white rounded-2xl shadow-sm border border-gray-100 ${className}`}>{children}</div>;
const Badge = ({label,color='teal'}) => {
  const cls={green:'bg-green-100 text-green-700',red:'bg-red-100 text-red-700',amber:'bg-amber-100 text-amber-700',teal:'bg-teal-light text-teal',navy:'bg-navy/10 text-navy'}[color]||'bg-teal-light text-teal';
  return <span className={`text-xs font-bold px-2.5 py-1 rounded-full ${cls}`}>{label}</span>;
};
const Checkbox = ({checked,onChange,label,isNA,onToggleNA}) => {
  if(isNA) return (
    <div className="flex items-center gap-3 py-2.5">
      <span className="w-6 h-6 rounded-lg border-2 border-gray-100 bg-gray-50 flex items-center justify-center flex-shrink-0">
        <span className="text-gray-300 text-[8px] font-black tracking-tight">NA</span>
      </span>
      <span className="flex-1 text-sm text-gray-300 line-through leading-snug">{label}</span>
      <button onClick={onToggleNA} className="text-[10px] font-bold text-teal px-2 py-1 rounded-lg bg-teal-light active:opacity-70 flex-shrink-0">Restore</button>
    </div>
  );
  return (
    <div className="flex items-center gap-3 py-2.5 w-full">
      <button onClick={()=>onChange(!checked)} className="flex items-center gap-3 flex-1 text-left active:opacity-60">
        <span className={`w-6 h-6 rounded-lg border-2 flex items-center justify-center flex-shrink-0 transition-colors ${checked?'bg-teal border-teal':'border-gray-200 bg-gray-50'}`}>
          {checked&&<Icon name="check" size={13} color="white"/>}
        </span>
        <span className={`text-sm leading-snug ${checked?'text-gray-400 line-through':'text-gray-700'}`}>{label}</span>
      </button>
      {onToggleNA&&<button onClick={onToggleNA} className="text-[10px] font-bold text-gray-300 px-1.5 py-0.5 rounded border border-gray-200 active:bg-gray-100 flex-shrink-0 ml-1">NA</button>}
    </div>
  );
};
const Input = ({label,value,onChange,type='text',placeholder='',required=false,hint}) => (
  <div className="mb-4">
    {label&&<label className="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">{label}{required&&<span className="text-red-400 ml-1">*</span>}</label>}
    <input type={type} value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder}
      className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 bg-gray-50 focus:outline-none focus:border-teal focus:bg-white transition-colors"/>
    {hint&&<p className="text-xs text-gray-400 mt-1">{hint}</p>}
  </div>
);
const Btn = ({children,onClick,variant='primary',className='',disabled=false,loading=false,size='md'}) => {
  const cls={primary:'bg-teal text-white active:opacity-80',navy:'bg-navy text-white active:opacity-80',ghost:'bg-gray-100 text-gray-600 active:bg-gray-200',outline:'border border-navy text-navy bg-white active:bg-gray-50',danger:'bg-red-500 text-white active:opacity-80'}[variant];
  const sz={md:'py-3.5 text-sm',sm:'py-2.5 text-xs',lg:'py-4 text-base'}[size];
  return (
    <button onClick={onClick} disabled={disabled||loading} className={`w-full ${sz} rounded-xl font-semibold transition-all flex items-center justify-center gap-2 ${cls} ${(disabled||loading)?'opacity-40':''} ${className}`}>
      {loading&&<div className="w-4 h-4 border-2 border-current/30 border-t-current rounded-full animate-spin"/>}
      {children}
    </button>
  );
};
const ErrMsg = ({msg}) => msg?<div className="bg-red-50 border border-red-100 text-red-600 text-sm rounded-xl px-4 py-3 mb-4 leading-snug">{msg}</div>:null;
const OkMsg = ({msg}) => msg?<div className="bg-green-50 border border-green-100 text-green-700 text-sm rounded-xl px-4 py-3 text-center font-semibold">{msg}</div>:null;

// ── TOP NAV ───────────────────────────────────────────────────────────────────
const TABS = [
  {key:'dashboard',label:'Home',icon:'home'},
  {key:'diary',label:'Diary',icon:'diary'},
  {key:'temp',label:'Temps',icon:'temp'},
  {key:'van',label:'Equipment',icon:'van'},
  {key:'records',label:'Records',icon:'eho'},
];
const TopNav = ({screen,onChange,profile}) => {
  const initials = (profile?.name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  return (
    <div className="vg-topnav fixed top-0 left-0 right-0 z-50 max-w-lg mx-auto">
      {/* Header bar */}
      <div className="bg-navy flex items-center px-4 h-14 gap-2.5">
        <div className="flex-shrink-0 flex items-center">
          <img src="/icon-navy.png" alt="VanGuard" style={{width:'40px',height:'38px',objectFit:'contain'}}/>
        </div>
        <div className="flex-1 min-w-0">
          <p className="text-white font-black text-base leading-none">Van<span className="text-teal">Guard</span></p>
          <p className="text-white/40 text-xs leading-none mt-0.5 truncate">{profile?.business_name||'Stay compliant. Keep moving.'}</p>
        </div>
        <button onClick={()=>onChange('account')} aria-label="Settings"
          className={`w-9 h-9 rounded-full flex items-center justify-center transition-all ${screen==='account'?'bg-teal text-white':'bg-white/10 text-white/80 hover:bg-white/20'}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
      </div>
      {/* Tab bar */}
      <div className="bg-white border-b border-gray-100 flex shadow-sm">
        {TABS.map(t=>(
          <button key={t.key} onClick={()=>onChange(t.key)}
            className={`flex-1 flex flex-col items-center py-2 gap-0.5 border-b-2 transition-all ${screen===t.key?'border-teal text-teal':'border-transparent text-gray-400'}`}>
            <Icon name={t.icon} size={18} color={screen===t.key?'#0D7377':'#9CA3AF'}/>
            <span className="text-[10px] font-semibold">{t.label}</span>
          </button>
        ))}
      </div>
    </div>
  );
};

// ── DESKTOP SIDEBAR (≥lg) ─────────────────────────────────────────────────────
const CogIcon = ({size=18})=>(
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
);
const DesktopSidebar = ({screen,onChange,profile,onHelp}) => {
  const item=(active)=>`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all ${active?'bg-teal text-white':'text-white/60 hover:bg-white/10 hover:text-white'}`;
  return (
    <div className="vg-sidebar hidden lg:flex lg:flex-col lg:w-64 lg:h-screen lg:sticky lg:top-0 shrink-0 bg-navy text-white">
      <div className="flex items-center gap-2.5 px-5 h-16 border-b border-white/10">
        <img src="/icon-navy.png" alt="VanGuard" style={{width:'34px',height:'32px',objectFit:'contain'}}/>
        <div className="min-w-0">
          <p className="font-black text-base leading-none">Van<span className="text-teal">Guard</span></p>
          <p className="text-white/40 text-[11px] leading-none mt-1 truncate">{profile?.business_name||'Stay compliant'}</p>
        </div>
      </div>
      <nav className="flex-1 py-4 px-3 space-y-1 overflow-y-auto">
        {TABS.map(t=>(
          <button key={t.key} onClick={()=>onChange(t.key)} className={item(screen===t.key)}>
            <Icon name={t.icon} size={18} color={screen===t.key?'white':'rgba(255,255,255,0.6)'}/>
            {t.label}
          </button>
        ))}
      </nav>
      <div className="px-3 py-4 border-t border-white/10 space-y-1">
        <button onClick={()=>onChange('account')} className={item(screen==='account')}><CogIcon/> Settings</button>
        <button onClick={onHelp} className={item(false)}><span className="w-[18px] text-center font-black">?</span> Help</button>
      </div>
    </div>
  );
};

// ── LANDING PAGE ──────────────────────────────────────────────────────────────
// ── ISO CAROUSEL ──────────────────────────────────────────────────────────────
const IsoCarousel = ({bg='#0C1628'}) => {
  const stkRef=useRef(null);
  const titleRef=useRef(null);
  const dotsRef=useRef(null);
  const wrapRef=useRef(null);
  useEffect(()=>{
    const S=[
      {t:'Dashboard',i:'📊',c:'#14A085',rows:[{l:'Temperature logs',v:'3 readings',ok:true},{l:'Van checks',v:'All clear',ok:true},{l:'Food diary',v:'Pending',ok:null},{l:'Cleaning log',v:'Done',ok:true}]},
      {t:'Temperature Log',i:'🌡',c:'#E85D04',rows:[{l:'Fridge',v:'3°C',ok:true},{l:'Freezer',v:'-18°C',ok:true},{l:'Hot hold',v:'68°C',ok:true},{l:'Delivery box',v:'5°C',ok:true}]},
      {t:'Van Checks',i:'🚐',c:'#0D7377',rows:[{l:'Wheels & tyres',ok:true},{l:'Fire extinguisher',ok:true},{l:'First aid kit',ok:true},{l:'Gas seals checked',ok:true}]},
      {t:'EHO Report',i:'📋',c:'#7209B7',cta:'↓ Download PDF report',rows:[{l:'30-day log complete',ok:true},{l:'Temperature records',ok:true},{l:'Cleaning schedule',ok:true},{l:'Food diary entries',ok:true}]},
      {t:'Food Diary',i:'📖',c:'#F77F00',rows:[{l:'09:15 Delivery in',v:'Butcher+veg'},{l:'11:00 Trading',v:'Borough Mkt'},{l:'14:30 Complaints',v:'None'},{l:'16:00 Waste',v:'0.5 kg'}]},
    ];
    const ZP=[115,58,0,-58,-115],OP=[1,0.82,0.64,0.48,0.34];
    const mkP=s=>{
      const rows=s.rows.map(r=>{const dot=r.ok===true?'#14A085':r.ok===null?'#F59E0B':'rgba(255,255,255,0.1)';return`<div style="display:flex;align-items:center;justify-content:space-between;padding:3.5px 0;border-bottom:0.5px solid rgba(255,255,255,0.07)"><div style="display:flex;align-items:center;gap:5px"><div style="width:5px;height:5px;border-radius:50%;flex-shrink:0;background:${dot}"></div><span style="font-size:7.5px;color:rgba(255,255,255,0.85)">${r.l}</span></div>${r.v?`<span style="font-size:7px;color:rgba(255,255,255,0.4)">${r.v}</span>`:''}</div>`;}).join('');
      const cta=s.cta?`<div style="margin-top:7px;background:${s.c};border-radius:5px;padding:4px 0;text-align:center;font-size:7px;font-weight:700;color:white">${s.cta}</div>`:'';
      return`<div style="width:144px;background:#07101f;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,0.1)"><div style="height:12px;background:#040c18;display:flex;align-items:center;justify-content:center"><div style="width:28px;height:2px;background:rgba(255,255,255,0.1);border-radius:2px"></div></div><div style="padding:7px 8px 7px"><div style="display:flex;align-items:center;gap:5px;margin-bottom:6px"><div style="width:19px;height:19px;background:${s.c};border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0">${s.i}</div><span style="font-size:9px;font-weight:700;color:white">${s.t}</span></div>${rows}${cta}</div><div style="height:10px;background:#040c18;display:flex;align-items:center;justify-content:center"><div style="width:32px;height:2px;background:rgba(255,255,255,0.1);border-radius:2px"></div></div></div><div style="font-size:7.5px;font-weight:600;color:rgba(255,255,255,0.3);letter-spacing:1px;text-align:center;margin-top:7px">${s.t.toUpperCase()}</div>`;
    };
    const stk=stkRef.current,titleEl=titleRef.current,dotsEl=dotsRef.current;
    if(!stk)return;
    const cards=S.map((s,i)=>{
      const d=document.createElement('div');
      d.style.cssText='position:absolute;top:50%;left:50%;width:170px;height:212px;background:rgba(8,17,38,0.93);border-top:1px solid rgba(255,255,255,0.30);border-left:1px solid rgba(255,255,255,0.15);border-right:1px solid rgba(255,255,255,0.07);border-bottom:1px solid rgba(255,255,255,0.07);border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px;box-sizing:border-box;will-change:transform,opacity';
      d.innerHTML=mkP(s);
      d.style.transform=`translate(-50%,-50%) translateZ(${ZP[i]}px)`;
      d.style.opacity=String(OP[i]);
      d.style.zIndex=String(10-i);
      stk.appendChild(d);
      return d;
    });
    let queue=[0,1,2,3,4],busy=false;
    const updateUI=()=>{
      if(titleEl)titleEl.textContent=S[queue[0]].t.toUpperCase();
      if(dotsEl)dotsEl.querySelectorAll('.iso-dot').forEach((d,i)=>{d.className='iso-dot'+(queue[0]===i?' iso-on':'');});
    };
    if(dotsEl){
      S.forEach((_,i)=>{
        const d=document.createElement('span');
        d.className='iso-dot'+(i===0?' iso-on':'');
        d.style.cssText='width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.22);display:inline-block;margin:0 3px;cursor:pointer;transition:all 0.3s;vertical-align:middle';
        d.onclick=()=>{
          if(busy||queue[0]===i)return;
          const pos=queue.indexOf(i);if(pos<0)return;
          queue=[...queue.slice(pos),...queue.slice(0,pos)];
          queue.forEach((sc,p)=>{cards[sc].style.transition='transform 0.46s cubic-bezier(0.4,0,0.2,1),opacity 0.36s';cards[sc].style.transform=`translate(-50%,-50%) translateZ(${ZP[p]}px)`;cards[sc].style.opacity=String(OP[p]);cards[sc].style.zIndex=String(10-p);});
          updateUI();
        };
        dotsEl.appendChild(d);
      });
    }
    // Dot active style via JS since we can't use a <style> tag cleanly in useEffect
    const styleEl=document.createElement('style');
    styleEl.textContent='.iso-on{background:#0D7377!important;width:20px!important;border-radius:3px!important}';
    document.head.appendChild(styleEl);
    const advance=()=>{
      if(busy)return;busy=true;
      const fi=queue[0],fc=cards[fi];
      fc.style.transition='transform 0.30s cubic-bezier(0.2,0,0.4,1),opacity 0.22s';
      fc.style.transform='translate(-50%,-50%) translateZ(210px) rotateY(-18deg) translateY(-6px)';
      fc.style.opacity='0.72';fc.style.zIndex='20';
      setTimeout(()=>{
        for(let p=1;p<5;p++){const sc=queue[p];cards[sc].style.transition='transform 0.50s cubic-bezier(0.4,0,0.2,1),opacity 0.38s';cards[sc].style.transform=`translate(-50%,-50%) translateZ(${ZP[p-1]}px)`;cards[sc].style.opacity=String(OP[p-1]);cards[sc].style.zIndex=String(10-(p-1));}
        fc.style.transition='transform 0.50s cubic-bezier(0.55,0,0.9,0.5),opacity 0.30s';
        fc.style.transform='translate(-50%,-50%) translateZ(-175px) rotateY(0deg) translateY(0px)';
        fc.style.opacity='0';
        setTimeout(()=>{
          const f=queue.shift();queue.push(f);
          fc.style.transition='none';fc.style.transform=`translate(-50%,-50%) translateZ(${ZP[4]}px)`;fc.style.zIndex='6';
          setTimeout(()=>{fc.style.transition='opacity 0.28s';fc.style.opacity=String(OP[4]);},30);
          updateUI();busy=false;
        },520);
      },310);
    };
    let timer=setInterval(advance,3800);
    const wrap=wrapRef.current;
    const isTouch='ontouchstart' in window||navigator.maxTouchPoints>0;
    if(wrap&&!isTouch){
      wrap.addEventListener('mouseenter',()=>clearInterval(timer));
      wrap.addEventListener('mouseleave',()=>{clearInterval(timer);timer=setInterval(advance,3800);});
    }
    return()=>{clearInterval(timer);styleEl.remove();while(stk.firstChild)stk.removeChild(stk.firstChild);if(dotsEl)dotsEl.innerHTML='';};
  },[]);
  return (
    <div ref={wrapRef} style={{background:bg,borderRadius:bg==='transparent'?0:'16px',padding:'28px 0 20px',margin:'0 0 0 0'}}>
      <div style={{perspective:'600px',perspectiveOrigin:'50% 44%',height:'310px',display:'flex',alignItems:'center',justifyContent:'center',overflow:'visible'}}>
        <div ref={stkRef} style={{position:'relative',width:'170px',height:'210px',transformStyle:'preserve-3d',transform:'rotateX(9deg) rotateY(-24deg)'}}></div>
      </div>
      <div ref={titleRef} style={{textAlign:'center',color:'rgba(255,255,255,0.42)',fontSize:'9.5px',fontWeight:'600',letterSpacing:'1.4px',marginTop:'4px'}}>DASHBOARD</div>
      <div ref={dotsRef} style={{textAlign:'center',marginTop:'13px'}}></div>
    </div>
  );
};

// ── LANDING PAGE ──────────────────────────────────────────────────────────────
const LandingPage = ({onGetStarted,onDemo}) => {
  const [userCount,setUserCount]=useState(null);
  useEffect(()=>{
    sb.from('profiles').select('*',{count:'exact',head:true})
      .then(({count})=>{if(count>=10)setUserCount(count);})
      .catch(()=>{});
  },[]);
  const features=[
    {icon:'temp',title:'Temperature Logs',desc:'Log fridge, hot hold & delivery temps in seconds. Timestamped and tamper-proof.'},
    {icon:'van',title:'Van & Cleaning Checks',desc:'Daily vehicle, equipment and cleaning checklists tailored to your unit type.'},
    {icon:'eho',title:'EHO Audit Report',desc:'One tap generates a PDF report covering your entire compliance history — ready for inspection day.'},
    {icon:'diary',title:'Food Safety Diary',desc:'Record deliveries, waste, complaints and allergen notes with date and time stamps.'},
  ];
  const steps=[
    {n:'1',title:'Start free trial',desc:'14 days free, every feature included. Card required to start — cancel anytime.'},
    {n:'2',title:'Log as you trade',desc:'30 seconds per check. Works on any phone, no app install needed.'},
    {n:'3',title:'Ace your inspection',desc:'Download your audit report and hand it straight to the EHO.'},
  ];
  return (
    <div className="min-h-screen bg-white" style={{fontFamily:'system-ui,-apple-system,sans-serif'}}>

      {/* ── NAV ── */}
      <div style={{background:'#1A2744'}} className="sticky top-0 z-50 flex items-center justify-between px-5 py-3">
        <div className="flex items-center gap-2">
          <img src="/icon-192.png" alt="VanGuard" style={{width:'28px',height:'28px',borderRadius:'7px'}}/>
          <span className="text-xl font-black text-white">Van<span style={{color:'#0D7377'}}>Guard</span></span>
        </div>
        <button onClick={()=>onGetStarted('login')}
          className="text-sm font-semibold text-white border border-white/30 rounded-lg px-4 py-1.5">
          Sign in
        </button>
      </div>

      {/* ── HERO (split: text left + carousel right) ── */}
      <div style={{
        background:'linear-gradient(115deg,#1A2744 0%,#122033 47%,#0C1628 100%)',
        position:'relative',
        overflow:'visible'
      }}>
        {/* Teal radial glow at the seam — visual glue between the two halves */}
        <div style={{
          position:'absolute',top:'50%',left:'47%',
          transform:'translate(-50%,-50%)',
          width:'360px',height:'360px',
          background:'radial-gradient(ellipse,rgba(13,115,119,0.16) 0%,transparent 68%)',
          pointerEvents:'none'
        }}/>
        {/* Subtle vertical highlight line at the seam — hidden on mobile */}
        <div className="hero-divider" style={{
          position:'absolute',top:'10%',left:'46.5%',
          width:'1px',height:'80%',
          background:'linear-gradient(to bottom,transparent,rgba(13,115,119,0.25) 30%,rgba(13,115,119,0.25) 70%,transparent)',
          pointerEvents:'none'
        }}/>

        <div className="hero-cols" style={{display:'flex',alignItems:'center',position:'relative',zIndex:2,minHeight:'390px'}}>

          {/* LEFT: headline + CTA */}
          <div className="hero-left" style={{flex:'0 0 47%',padding:'36px 14px 36px 20px',display:'flex',flexDirection:'column',justifyContent:'center',alignItems:'center',textAlign:'center'}}>
            <div className="hero-logo-row" style={{display:'flex',alignItems:'center',justifyContent:'center',gap:'8px',marginBottom:'14px'}}>
              <img src="/icon-192.png" alt="VanGuard" style={{width:'30px',height:'30px',borderRadius:'8px',boxShadow:'0 4px 16px rgba(0,0,0,0.5)',flexShrink:0}}/>
              <span style={{fontSize:'8px',fontWeight:'700',letterSpacing:'1.3px',color:'rgba(255,255,255,0.38)',lineHeight:'1.4',textTransform:'uppercase'}}>Mobile caterer<br/>food safety</span>
            </div>
            <h1 style={{color:'white',fontSize:'30px',fontWeight:'900',lineHeight:'1.1',margin:'0 0 10px',letterSpacing:'-0.5px'}}>
              Stay compliant.<br/>Keep moving.
            </h1>
            <p style={{color:'rgba(255,255,255,0.5)',fontSize:'11.5px',lineHeight:'1.6',margin:'0 0 20px'}}>
              Food safety records built for mobile caterers. EHO-ready in under a minute a day.
            </p>
            <button onClick={()=>onGetStarted('register')}
              style={{background:'#0D7377',color:'white',fontWeight:'800',fontSize:'13px',padding:'13px 0',borderRadius:'14px',border:'none',cursor:'pointer',width:'100%',boxShadow:'0 4px 24px rgba(13,115,119,0.45)',letterSpacing:'0.2px'}}>
              Start Free Trial
            </button>
            <button onClick={onDemo}
              style={{background:'rgba(255,255,255,0.08)',color:'white',fontWeight:'700',fontSize:'12.5px',padding:'11px 0',borderRadius:'14px',border:'1px solid rgba(255,255,255,0.25)',cursor:'pointer',width:'100%',marginTop:'10px'}}>
              Take a look inside
            </button>
            <button onClick={()=>onGetStarted('login')}
              style={{background:'transparent',border:'none',color:'rgba(255,255,255,0.3)',fontSize:'10px',padding:'9px 0 0',cursor:'pointer',fontWeight:'600',textAlign:'center'}}>
              Already have an account?
            </button>
            <p style={{color:'rgba(255,255,255,0.18)',fontSize:'9px',textAlign:'center',margin:'5px 0 0'}}>14-day free trial · Cancel anytime</p>
          </div>

          {/* RIGHT: live carousel */}
          <div className="hero-right" style={{flex:'1',display:'flex',flexDirection:'column',alignItems:'center',justifyContent:'center',overflow:'visible',padding:'8px 0'}}>
            <p style={{color:'rgba(255,255,255,0.28)',fontSize:'8.5px',fontWeight:'700',letterSpacing:'1.6px',marginBottom:'2px',textAlign:'center'}}>SEE IT IN ACTION</p>
            <IsoCarousel bg="transparent"/>
          </div>

        </div>
      </div>

      {/* ── TRUST STRIP ── */}
      <div className="border-b border-gray-100">
        {userCount&&(
          <div className="flex items-center justify-center gap-2 py-3 border-b border-gray-100" style={{background:'#E6F6F6'}}>
            <span className="text-lg">👨‍🍳</span>
            <span className="text-sm font-bold" style={{color:'#0D7377'}}>{userCount} mobile caterers</span>
            <span className="text-xs text-gray-500">already keeping records with VanGuard</span>
          </div>
        )}
        <div className="flex justify-around px-4 py-5">
          {[['✓','14-day free trial'],['✓','Cancel anytime'],['✓','Any phone']].map(([icon,label])=>(
            <div key={label} className="flex items-center gap-1.5">
              <span className="font-bold text-sm" style={{color:'#0D7377'}}>{icon}</span>
              <span className="text-xs text-gray-500 font-medium">{label}</span>
            </div>
          ))}
        </div>
      </div>

      {/* ── PROBLEM ── */}
      <div className="px-5 py-10">
        <h2 className="text-xl font-black text-center mb-2" style={{color:'#1A2744'}}>
          Paper records are a liability.
        </h2>
        <p className="text-gray-500 text-sm text-center mb-6 leading-relaxed">
          Most food safety apps are built for restaurants — too complex, too expensive, or missing the checks mobile caterers actually need. Paper gets wet, lost, or forgotten. Neither impresses an EHO.
        </p>
        <div className="rounded-2xl p-4" style={{background:'#E6F6F6'}}>
          <p className="text-sm font-bold mb-2" style={{color:'#0D7377'}}>VanGuard is different:</p>
          {['Designed around the mobile caterer workflow','Van, trailer & gazebo-specific checks','Instant audit report — no manual compilation','£7.99/month. Not £50+ like the big players'].map(p=>(
            <div key={p} className="flex items-start gap-2 mb-2">
              <span className="mt-0.5 font-bold flex-shrink-0" style={{color:'#0D7377'}}>→</span>
              <span className="text-sm text-gray-700">{p}</span>
            </div>
          ))}
        </div>
      </div>

      {/* ── FEATURES ── */}
      <div style={{background:'#F8FAFB'}} className="px-5 py-10">
        <h2 className="text-xl font-black text-center mb-1" style={{color:'#1A2744'}}>Everything you need.</h2>
        <p className="text-gray-400 text-sm text-center mb-6">Nothing you don't.</p>
        <div className="grid grid-cols-2 gap-3">
          {features.map(f=>(
            <div key={f.title} className="bg-white rounded-2xl p-4 shadow-sm">
              <div className="w-9 h-9 rounded-xl flex items-center justify-center mb-3" style={{background:'#E6F6F6'}}>
                <Icon name={f.icon} size={18} color="#0D7377"/>
              </div>
              <p className="text-xs font-bold mb-1" style={{color:'#1A2744'}}>{f.title}</p>
              <p className="text-xs text-gray-400 leading-relaxed">{f.desc}</p>
            </div>
